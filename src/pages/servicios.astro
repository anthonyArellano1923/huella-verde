---
/** Página de servicios: detalle de cada uno + tabla de precios por tamaño. */
import Base from '../layouts/Base.astro';
import TablaPrecios from '../components/TablaPrecios.astro';
import { SERVICIOS, TAMANOS } from '../data/servicios';
---

<Base
  titulo="Servicios y precios"
  descripcion="Baño, baño y corte, stripping y deslanado para perros pequeños, medianos y grandes. Precios claros y reserva online."
>
  <div class="contenedor">
    <header class="encabezado">
      <h1>Servicios</h1>
      <p>
        Todos los servicios se realizan con hora reservada, para que tu perrito
        no espere en jaula. El precio depende del tamaño:
      </p>
      <ul class="tamanos">
        {
          TAMANOS.map((t) => (
            <li>
              <strong>{t.nombre}:</strong> {t.descripcion}
            </li>
          ))
        }
      </ul>
    </header>

    <TablaPrecios />

    <section class="detalle">
      {
        SERVICIOS.map((s) => (
          <article id={s.id}>
            <h2>{s.nombre}</h2>
            <p>{s.descripcion}</p>
            <h3>Incluye</h3>
            <ul>
              {s.incluye.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="boton" href={`/reservar/?servicio=${s.id}`}>
              Reservar {s.nombre.toLowerCase()}
            </a>
          </article>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .encabezado {
    padding-block: var(--espacio-xl) var(--espacio-l);
    max-width: 65ch;
  }

  .encabezado p {
    margin-block: var(--espacio-m);
    color: var(--color-texto-suave);
  }

  .tamanos {
    margin: 0 0 var(--espacio-m);
    padding-inline-start: 1.2em;
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .detalle {
    display: grid;
    gap: var(--espacio-l);
    margin-block-start: var(--espacio-xl);

    & article {
      padding: var(--espacio-l);
      background: var(--color-superficie);
      border: 1px solid var(--color-borde);
      border-radius: var(--radio-m);

      & h3 {
        margin-block-start: var(--espacio-m);
        font-size: var(--texto-base);
      }

      & ul {
        margin-block: var(--espacio-s) var(--espacio-m);
        color: var(--color-texto-suave);
      }
    }
  }
</style>
