---
/**
 * Portada de marca compartida: hero breve, dos "puertas" (Peluquería y Tienda
 * de plantas), resumen de servicios y franja editorial de la tienda.
 */
import Base from '../layouts/Base.astro';
import LogoHuellaVerde from '../components/LogoHuellaVerde.astro';
import IconoGrooming from '../components/IconoGrooming.astro';
import Ilustracion from '../components/ilustraciones/Ilustracion.astro';
import { SERVICIOS } from '../data/servicios';
import { formatCLP } from '../utils/money';

const categorias = [
  { id: 'nativa-arbusto', nombre: 'Nativas', href: '/plantas/' },
  { id: 'monstera', nombre: 'De interior', href: '/plantas/' },
  { id: 'macetero-terracota', nombre: 'Maceteros', href: '/accesorios/' },
  { id: 'regadera', nombre: 'Cuidado', href: '/accesorios/' },
];
---

<Base
  titulo="Peluquería canina y tienda de plantas"
  descripcion="Huella Verde: peluquería canina con reserva de hora online y tienda de plantas nativas, maceteros y accesorios de cuidado en Santiago."
>
  <section class="hero">
    <div class="contenedor hero__contenido">
      <LogoHuellaVerde size={80} class="hero__emblema" title="Emblema de Huella Verde" />
      <h1>Cuidamos a tu perro y a tus plantas</h1>
      <p class="bajada">
        Dos mundos bajo un mismo techo en Santiago: una peluquería canina con hora reservada online
        y una tienda de plantas nativas y accesorios para el hogar.
      </p>
    </div>
  </section>

  <section class="contenedor puertas" aria-label="Elige por dónde empezar">
    <article class="puerta puerta--peluqueria" data-vertical="peluqueria" aria-labelledby="puerta-peluqueria">
      <IconoGrooming tipo="perro" size={56} class="puerta__icono" />
      <p class="sobretitulo">Peluquería canina</p>
      <h2 id="puerta-peluqueria">Baño, corte y mucho cariño</h2>
      <p>
        Tu perro sale limpio, peinado y feliz. Reserva online en un minuto, sin llamadas ni esperas.
      </p>
      <div class="acciones">
        <a class="boton" href="/reservar/">Reservar hora</a>
        <a class="boton boton--secundario" href="/servicios/">Ver servicios y precios</a>
      </div>
    </article>

    <article class="puerta puerta--tienda" data-vertical="tienda" aria-labelledby="puerta-tienda">
      <div class="marco-ilus puerta__ilus">
        <Ilustracion id="monstera" />
      </div>
      <p class="sobretitulo">Tienda de plantas</p>
      <h2 id="puerta-tienda">Flora nativa y objetos para cuidarla</h2>
      <p>
        Plantas de la zona central de Chile, maceteros, sustratos y herramientas elegidas con ojo
        editorial para que tu casa respire verde.
      </p>
      <div class="acciones">
        <a class="boton" href="/plantas/">Ver plantas</a>
        <a class="boton boton--secundario" href="/accesorios/">Accesorios y cuidado</a>
      </div>
    </article>
  </section>

  <section class="contenedor seccion" aria-labelledby="titulo-servicios">
    <p class="sobretitulo">Peluquería</p>
    <h2 id="titulo-servicios">Servicios</h2>
    <ul class="servicios">
      {
        SERVICIOS.map((s) => (
          <li>
            <IconoGrooming tipo={s.icono} size={30} class="icono-servicio" />
            <h3>{s.nombre}</h3>
            <p>{s.descripcion}</p>
            <p class="desde">
              {s.precioDesdePorTamano ? (
                <>Desde <strong class="precio">{formatCLP(s.precioDesdePorTamano.pequeno)}</strong></>
              ) : (
                <>Precio a consultar</>
              )}
            </p>
            <svg class="huella-marca" viewBox="0 0 100 100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="50" cy="60" rx="17" ry="14" />
              <ellipse cx="30" cy="44" rx="6" ry="9" transform="rotate(-18 30 44)" />
              <ellipse cx="43" cy="34" rx="6" ry="9" transform="rotate(-6 43 34)" />
              <ellipse cx="57" cy="34" rx="6" ry="9" transform="rotate(6 57 34)" />
              <ellipse cx="70" cy="44" rx="6" ry="9" transform="rotate(18 70 44)" />
            </svg>
          </li>
        ))
      }
    </ul>
    <p>
      <a href="/servicios/">Ver precios por tamaño de perro →</a>
    </p>
  </section>

  <section class="franja" data-vertical="tienda" aria-labelledby="titulo-tienda">
    <div class="contenedor">
      <p class="sobretitulo">Tienda</p>
      <h2 id="titulo-tienda">Para vivir entre plantas</h2>
      <ul class="categorias">
        {
          categorias.map((c) => (
            <li>
              <a href={c.href} class="categoria">
                <span class="marco-ilus">
                  <Ilustracion id={c.id} />
                </span>
                <span class="categoria__nombre">{c.nombre}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--espacio-xl) var(--espacio-l);
    background: linear-gradient(180deg, var(--color-primario-suave), var(--color-fondo));
    text-align: center;
  }

  .hero__contenido {
    position: relative;
  }

  .hero :global(.hero__emblema) {
    margin-inline: auto;
    margin-block-end: var(--espacio-m);
  }

  .hero h1 {
    max-inline-size: 20ch;
    margin-inline: auto;
    margin-block-end: var(--espacio-m);
  }

  .bajada {
    max-inline-size: 55ch;
    margin-inline: auto;
    color: var(--color-texto-suave);
  }

  /* Dos puertas: apiladas en móvil, lado a lado desde 48rem. Un container
     query sería excesivo aquí; media query simple y legible. */
  .puertas {
    display: grid;
    gap: var(--espacio-m);
    padding-block-start: var(--espacio-l);
  }

  @media (width >= 48rem) {
    .puertas {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Cada puerta fija su vertical con data-vertical; en la tienda el
     re-mapeo de tokens cambia color primario y tipografía de títulos. */
  .puerta {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-s);
    padding: var(--espacio-l);
    background: var(--color-primario-suave);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2.4);
    border-block-start: 5px solid var(--color-primario);

    & h2 {
      font-size: var(--texto-xl);
    }

    & p:not(.sobretitulo) {
      color: var(--color-texto-suave);
    }
  }

  .puerta--tienda h2 {
    font-family: var(--fuente-editorial);
  }

  .puerta :global(.puerta__icono) {
    color: var(--color-primario);
  }

  .puerta__ilus {
    inline-size: min(100%, 9rem);
    padding: var(--espacio-s);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-s) var(--espacio-m);
    margin-block-start: auto;
    padding-block-start: var(--espacio-s);
  }

  .acciones .boton {
    min-block-size: 44px;
  }

  .seccion {
    padding-block-start: var(--espacio-2xl);

    & h2 {
      margin-block-end: var(--espacio-m);
    }
  }

  .servicios {
    display: grid;
    gap: var(--espacio-m);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin: 0 0 var(--espacio-m);
    padding: 0;
    list-style: none;

    & li {
      position: relative;
      overflow: hidden;
      padding: var(--espacio-l);
      padding-block-start: var(--espacio-xl);
      background: var(--color-superficie);
      border: 1px solid var(--color-borde);
      /* Esquina orgánica: rompe la caja perfecta sin dejar de ser prolija */
      border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2.4);
      box-shadow: var(--sombra-tarjeta);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    /* Cinta de acento verde en el borde superior */
    & li::before {
      content: '';
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      block-size: 5px;
      background: linear-gradient(90deg, var(--color-primario), var(--color-acento));
    }

    & li:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 22px oklch(0.4 0.06 155 / 0.14);
    }

    & h3 {
      margin-block-end: var(--espacio-xs);
    }

    & p {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
    }

    & .desde {
      margin-block-start: var(--espacio-s);
      color: var(--color-texto);
    }
  }

  /* Ícono de grooming sobre el título de cada servicio */
  .servicios :global(.icono-servicio) {
    margin-block-end: var(--espacio-xs);
    color: var(--color-primario);
  }

  /* Huella de agua tenue en la esquina de la tarjeta */
  .huella-marca {
    position: absolute;
    inset-block-end: -0.6rem;
    inset-inline-end: -0.6rem;
    inline-size: 5.5rem;
    block-size: 5.5rem;
    fill: var(--color-primario);
    opacity: 0.06;
    pointer-events: none;
  }

  /* Franja de la tienda: fondo propio para separarla del lado peluquería */
  .franja {
    margin-block-start: var(--espacio-2xl);
    padding-block: var(--espacio-xl);
    background: var(--color-primario-suave);

    & h2 {
      margin-block-end: var(--espacio-m);
    }
  }

  .categorias {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--espacio-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .categorias {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Each category is a white card on the mint band: the illustration frame
     and the band share almost the same tint, so the card's own surface,
     border and shadow are what separate one category from the next. */
  .categoria {
    display: grid;
    gap: var(--espacio-s);
    block-size: 100%;
    padding: var(--espacio-s) var(--espacio-s) var(--espacio-xs);
    color: var(--color-texto);
    text-decoration: none;
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2.4);
    box-shadow: var(--sombra-tarjeta);
    transition: border-color 0.15s, transform 0.15s;

    &:hover {
      border-color: var(--color-primario);
      transform: translateY(-2px);
    }

    &:hover .categoria__nombre {
      color: var(--color-primario-fuerte);
      text-decoration: underline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .categoria:hover {
      transform: none;
    }
  }

  .categoria__nombre {
    min-block-size: 44px;
    padding-inline: var(--espacio-xs);
    font-family: var(--fuente-editorial);
    font-size: var(--texto-l);
    font-weight: 700;
  }
</style>
