---
/** Portada: hero con llamado a reservar + servicios resumidos + ropita destacada. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PrendaCard from '../components/PrendaCard.astro';
import LogoHuellaVerde from '../components/LogoHuellaVerde.astro';
import IconoGrooming from '../components/IconoGrooming.astro';
import { NEGOCIO } from '../data/negocio';
import { SERVICIOS } from '../data/servicios';
import { formatCLP } from '../utils/money';

const destacadas = (await getCollection('prendas', ({ data }) => data.destacada && data.stock > 0)).slice(0, 3);
---

<Base titulo="Peluquería canina y ropita de perro" descripcion={NEGOCIO.descripcion}>
  <section class="hero">
    <IconoGrooming tipo="tijeras" size={116} class="deco-hero deco-hero--izq" />
    <IconoGrooming tipo="peine" size={116} class="deco-hero deco-hero--der" />
    <div class="contenedor hero__contenido">
      <LogoHuellaVerde size={92} class="hero__emblema" title="Emblema de Huella Verde" />
      <p class="saludo">Peluquería canina · {NEGOCIO.direccion.comuna}</p>
      <h1>Tu perrito, limpio, peinado y <em>abrigado</em></h1>
      <p class="bajada">
        Baño, corte y stripping con hora reservada online — sin llamadas ni esperas.
        Y para el invierno, ropita tejida a mano por {NEGOCIO.duena}.
      </p>
      <div class="acciones">
        <a class="boton" href="/reservar/">Reservar hora</a>
        <a class="boton boton--secundario" href="/ropita/">Ver la ropita</a>
      </div>
    </div>
  </section>

  <section class="contenedor seccion" aria-labelledby="titulo-servicios">
    <h2 id="titulo-servicios">Servicios</h2>
    <ul class="servicios">
      {
        SERVICIOS.map((s) => (
          <li>
            <IconoGrooming tipo={s.icono} size={30} class="icono-servicio" />
            <h3>{s.nombre}</h3>
            <p>{s.descripcion}</p>
            <p class="desde">
              {s.precioDesdePorTamano ? (
                <>Desde <strong>{formatCLP(s.precioDesdePorTamano.pequeno)}</strong></>
              ) : (
                <>Precio a consultar</>
              )}
            </p>
            <svg class="huella-marca" viewBox="0 0 100 100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="50" cy="60" rx="17" ry="14" />
              <ellipse cx="30" cy="44" rx="6" ry="9" transform="rotate(-18 30 44)" />
              <ellipse cx="43" cy="34" rx="6" ry="9" transform="rotate(-6 43 34)" />
              <ellipse cx="57" cy="34" rx="6" ry="9" transform="rotate(6 57 34)" />
              <ellipse cx="70" cy="44" rx="6" ry="9" transform="rotate(18 70 44)" />
            </svg>
          </li>
        ))
      }
    </ul>
    <p>
      <a href="/servicios/">Ver precios por tamaño de perro →</a>
    </p>
  </section>

  {
    destacadas.length > 0 && (
      <section class="contenedor seccion" aria-labelledby="titulo-ropita">
        <h2 id="titulo-ropita">Ropita destacada</h2>
        <p>Prendas únicas, tejidas a mano. Cuando se venden, se acabaron.</p>
        <div class="grilla-prendas">
          {destacadas.map((prenda) => (
            <PrendaCard prenda={prenda} />
          ))}
        </div>
        <p>
          <a href="/ropita/">Ver todo el catálogo →</a>
        </p>
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--espacio-2xl);
    background:
      radial-gradient(120% 80% at 50% -10%, var(--color-primario-suave), transparent 60%),
      linear-gradient(180deg, var(--color-primario-suave), var(--color-fondo));
    text-align: center;
  }

  /* Herramientas de grooming decorando el hero: tijeras y peine, sutiles. */
  .hero :global(.deco-hero) {
    position: absolute;
    inset-block-start: 12%;
    color: var(--color-primario);
    opacity: 0.16;
    pointer-events: none;
  }

  .hero :global(.deco-hero--izq) {
    inset-inline-start: 4%;
    transform: rotate(-16deg);
  }

  .hero :global(.deco-hero--der) {
    inset-inline-end: 4%;
    transform: rotate(12deg);
  }

  .hero__contenido {
    position: relative;
    z-index: 1;
  }

  .hero :global(.hero__emblema) {
    margin-inline: auto;
    margin-block-end: var(--espacio-m);
  }

  .saludo {
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-size: var(--texto-s);
    color: var(--color-primario-fuerte);
  }

  .hero h1 {
    max-width: 22ch;
    margin-inline: auto;
    margin-block: var(--espacio-s) var(--espacio-m);

    & em {
      font-style: normal;
      color: var(--color-primario-fuerte);
    }
  }

  /* En pantallas chicas las herramientas estorban el texto: se ocultan */
  @media (width < 46rem) {
    .hero :global(.deco-hero) {
      display: none;
    }
  }

  .bajada {
    max-width: 55ch;
    margin-inline: auto;
    color: var(--color-texto-suave);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-m);
    margin-block-start: var(--espacio-l);
  }

  .seccion {
    padding-block-start: var(--espacio-2xl);

    & h2 {
      margin-block-end: var(--espacio-m);
    }
  }

  .servicios {
    display: grid;
    gap: var(--espacio-m);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin: 0 0 var(--espacio-m);
    padding: 0;
    list-style: none;

    & li {
      position: relative;
      overflow: hidden;
      padding: var(--espacio-l);
      padding-block-start: var(--espacio-xl);
      background: var(--color-superficie);
      border: 1px solid var(--color-borde);
      /* Esquina orgánica: rompe la caja perfecta sin dejar de ser prolija */
      border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2.4);
      box-shadow: var(--sombra-tarjeta);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    /* Cinta de acento verde en el borde superior */
    & li::before {
      content: '';
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      block-size: 5px;
      background: linear-gradient(90deg, var(--color-primario), var(--color-acento));
    }

    & li:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 22px oklch(0.4 0.06 155 / 0.14);
    }

    & h3 {
      margin-block-end: var(--espacio-xs);
    }

    & p {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
    }

    & .desde {
      margin-block-start: var(--espacio-s);
      color: var(--color-texto);
    }
  }

  /* Ícono de grooming sobre el título de cada servicio */
  .servicios :global(.icono-servicio) {
    margin-block-end: var(--espacio-xs);
    color: var(--color-primario);
  }

  /* Huella de agua tenue en la esquina de la tarjeta */
  .huella-marca {
    position: absolute;
    inset-block-end: -0.6rem;
    inset-inline-end: -0.6rem;
    inline-size: 5.5rem;
    block-size: 5.5rem;
    fill: var(--color-primario);
    opacity: 0.06;
    pointer-events: none;
  }

  .grilla-prendas {
    display: grid;
    gap: var(--espacio-m);
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    margin-block: var(--espacio-m);
  }
</style>
