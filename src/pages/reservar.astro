---
/**
 * Página de reservas: selector de servicio + widget de Cal.com incrustado.
 *
 * El selector cambia el tipo de evento del widget (cada servicio es un tipo
 * de evento distinto en Cal.com, con su duración y buffer). El tamaño del
 * perro solo actualiza la referencia de precio/duración mostrada — el cobro
 * se hace en el local (rama main).
 *
 * TODO(Anthony): el widget funciona de verdad cuando exista la cuenta
 * Cal.com (Fase 2) y `calcomUsuario` en negocio.ts sea el username real.
 */
import Base from '../layouts/Base.astro';
import { NEGOCIO } from '../data/negocio';
import { SERVICIOS, TAMANOS, DURACION_SERVICIO_MIN, POLITICAS_RESERVA } from '../data/servicios';
import { formatCLP } from '../utils/money';
import { waLink, waLinkReserva } from '../utils/whatsapp';
import { TERMINOS } from '../data/terminos';

// Datos que necesita el script del cliente, serializados una sola vez.
const datosCliente = {
  usuario: NEGOCIO.calcomUsuario,
  duracionMin: DURACION_SERVICIO_MIN,
  servicios: SERVICIOS.map((s) => ({
    id: s.id,
    slug: s.calcomSlug,
    precioDesdePorTamano: s.precioDesdePorTamano,
  })),
};
---

<Base
  titulo="Reservar hora"
  descripcion="Reserva online tu hora de baño, corte, stripping o deslanado. Eliges el día y la hora, te llega la confirmación al correo."
>
  <div class="contenedor">
    <header class="encabezado">
      <h1>Reservar hora</h1>
      <p>
        Elige el servicio, luego el día y la hora en el calendario. Te llegará
        la confirmación por correo y puedes cancelar o cambiar la hora desde
        el mismo correo.
      </p>
      <ul class="politicas">
        <li>Las reservas se hacen con al menos <strong>{POLITICAS_RESERVA.anticipacionMinimaHoras} horas de anticipación</strong>, y puedes cancelar hasta <strong>{POLITICAS_RESERVA.cancelacionHoras} horas antes</strong>.</li>
        <li>Cada servicio toma entre 1½ y 2 horas; la última hora del día es a las <strong>{POLITICAS_RESERVA.ultimaHoraInicio}</strong>.</li>
        <li>{POLITICAS_RESERVA.notaPrecios}</li>
        <li>{POLITICAS_RESERVA.notaHorarioEspecial}</li>
      </ul>
    </header>

    <form class="selector" aria-label="Elige servicio y tamaño de tu perro">
      <fieldset>
        <legend>Servicio</legend>
        <div class="pildoras">
          {
            SERVICIOS.map((s, i) => (
              <label>
                <input type="radio" name="servicio" value={s.id} checked={i === 0} />
                <span>{s.nombre}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend>Tamaño de tu perro</legend>
        <div class="pildoras">
          {
            TAMANOS.map((t, i) => (
              <label>
                <input type="radio" name="tamano" value={t.id} checked={i === 0} />
                <span>{t.nombre}</span>
                <small>{t.descripcion}</small>
              </label>
            ))
          }
        </div>
      </fieldset>
    </form>

    <p class="referencia" id="referencia-precio" aria-live="polite">
      {/* El script rellena esto: "Baño completo, perro pequeño: $12.000, ~45 min" */}
    </p>

    {/*
      El pago online depende de variables de runtime (PAGOS_ONLINE,
      credenciales) que esta página estática no conoce: el script consulta
      /api/pago/estado y recién ahí muestra el botón de pago o, si no está
      disponible, el enlace a WhatsApp. data-wa-base = "https://wa.me/<fono>?text=".
    */}
    <aside class="pagar-online" id="pagar-online" data-wa-base={waLink('')}>
      <h2>¿Quieres dejar tu hora pagada? <span class="opcional">(opcional)</span></h2>
      <p id="explicacion-pago-reserva">
        Paga ahora online y agenda después: al aprobarse el pago recibirás
        una <strong>referencia</strong> para escribir en las notas de tu
        reserva. Se paga el <strong>precio base ("desde")</strong>; si tu
        perrito requiere trabajo extra por su raza, la diferencia se paga en
        el local. También puedes pagar todo en el local, como siempre.
      </p>
      <p class="estado-pago" id="estado-pago-reserva" aria-live="polite">Cargando medios de pago…</p>
      {/* Ley 19.496 art. 3 bis: la exclusión del retracto en servicios debe
          informarse de forma destacada antes del pago. */}
      {TERMINOS.reservas.excluirRetracto && (
        <p class="aviso-retracto" id="aviso-retracto-reserva" hidden>
          Las reservas pagadas no tienen derecho a retracto: puedes cancelarlas o cambiarlas
          hasta {POLITICAS_RESERVA.cancelacionHoras} horas antes.{' '}
          <a href="/terminos/#reservas">Ver condiciones de reserva</a>
        </p>
      )}
      <button class="boton boton--secundario" type="button" id="boton-pagar-reserva" hidden>
        Pagar esta reserva ahora
      </button>
      <a class="boton boton--whatsapp" id="whatsapp-pagar-reserva" href={waLinkReserva()} rel="noopener" hidden>
        Coordinar el pago por WhatsApp
      </a>
      <p class="error-pago" id="error-pago-reserva" role="alert" hidden></p>
    </aside>

    <div id="cal-contenedor" class="cal-contenedor">
      <p class="cal-cargando">Cargando la agenda…</p>
    </div>

    {/*
      Aviso para cuando el calendario no carga (cuenta inexistente, Cal.com
      caído, bloqueador de anuncios). Va en la plantilla y no se crea desde
      JavaScript a propósito: Astro limita los estilos de este archivo a los
      elementos que existen en el build, así que un <div> creado con
      createElement quedaría SIN estilos. Es hermano del contenedor porque
      montar el calendario hace replaceChildren() sobre él.
    */}
    <div id="cal-caido" class="cal-caido" hidden>
      <h2>La agenda online no está disponible en este momento</h2>
      <p>Reserva tu hora por WhatsApp: te respondemos y te confirmamos al tiro.</p>
      <a class="boton boton--whatsapp" href={waLinkReserva()} rel="noopener">
        Reservar por WhatsApp
      </a>
    </div>
    <p class="alternativa">
      ¿No carga la agenda o ningún horario te acomoda?
      <a href={waLinkReserva()} rel="noopener">Escríbenos por WhatsApp</a> y coordinamos.
    </p>
  </div>
</Base>

<script is:inline define:vars={{ datos: datosCliente }}>
  /* — Snippet oficial de Cal.com (embed vanilla) — */
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ['initNamespace', namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  const contenedor = document.getElementById('cal-contenedor');
  const avisoCaido = document.getElementById('cal-caido');
  const referencia = document.getElementById('referencia-precio');
  const form = document.querySelector('.selector');
  let versionCalendario = 0;

  const formatCLP = (n) =>
    new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

  const nombreServicio = {};
  document.querySelectorAll('input[name="servicio"]').forEach((input) => {
    nombreServicio[input.value] = input.parentElement.textContent.trim();
  });
  const nombreTamano = {};
  document.querySelectorAll('input[name="tamano"]').forEach((input) => {
    nombreTamano[input.value] = input.parentElement.querySelector('span').textContent.trim();
  });

  function seleccionActual() {
    const servicioId = form.elements.servicio.value;
    const tamanoId = form.elements.tamano.value;
    return {
      servicio: datos.servicios.find((s) => s.id === servicioId),
      servicioId,
      tamanoId,
    };
  }

  function actualizarReferencia() {
    const { servicio, servicioId, tamanoId } = seleccionActual();
    const precios = servicio.precioDesdePorTamano;
    const textoPrecio = precios
      ? `desde ${formatCLP(precios[tamanoId])} (según la raza)`
      : 'precio a consultar por WhatsApp';
    referencia.textContent =
      `${nombreServicio[servicioId]}, perro ${nombreTamano[tamanoId].toLowerCase()}: ` +
      `${textoPrecio}, entre 1½ y 2 horas. Paga en el local u online, como prefieras.`;
  }

  // — Pago online de la reserva (pasarela activa según PASARELA_PAGO) —
  const botonPagar = document.getElementById('boton-pagar-reserva');
  const errorPago = document.getElementById('error-pago-reserva');
  const enlaceWaPago = document.getElementById('whatsapp-pagar-reserva');
  const estadoPago = document.getElementById('estado-pago-reserva');
  const waBase = document.getElementById('pagar-online').dataset.waBase;

  // Mensaje de WhatsApp con la selección actual (servicio, tamaño y precio).
  function actualizarEnlaceWa() {
    const { servicio, servicioId, tamanoId } = seleccionActual();
    const precios = servicio.precioDesdePorTamano;
    const texto =
      `¡Hola! Quiero dejar pagada una reserva de ${nombreServicio[servicioId]} ` +
      `para perro ${nombreTamano[tamanoId].toLowerCase()}` +
      (precios ? ` (desde ${formatCLP(precios[tamanoId])})` : '') +
      '. ¿Cómo coordinamos el pago?';
    enlaceWaPago.href = waBase + encodeURIComponent(texto);
  }

  // Pregunta al servidor si el pago con tarjeta está disponible (interruptor
  // PAGOS_ONLINE y credenciales). Si falla la consulta, se ofrece WhatsApp:
  // /api/pago/crear también fallaría.
  fetch('/api/pago/estado', { cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : { tarjeta: false }))
    .catch(() => ({ tarjeta: false }))
    .then((medios) => {
      const tarjeta = medios.tarjeta === true;
      botonPagar.hidden = !tarjeta;
      // "Paga ahora online…" contradice el aviso de no disponible: se oculta.
      document.getElementById('explicacion-pago-reserva').hidden = !tarjeta;
      // The no-withdrawal notice only applies when an online payment is offered.
      const avisoRetracto = document.getElementById('aviso-retracto-reserva');
      if (avisoRetracto) avisoRetracto.hidden = !tarjeta;
      enlaceWaPago.hidden = tarjeta;
      estadoPago.hidden = tarjeta;
      estadoPago.textContent = tarjeta
        ? ''
        : 'El pago online no está disponible en este momento. Puedes pagar en el local o coordinarlo por WhatsApp.';
    });

  // Stripping/deslanado no tienen precio base: se cotizan por WhatsApp,
  // así que no se pueden dejar pagados online.
  function actualizarBotonPagar() {
    const { servicio } = seleccionActual();
    const sinPrecio = !servicio.precioDesdePorTamano;
    botonPagar.disabled = sinPrecio;
    botonPagar.textContent = sinPrecio
      ? 'Este servicio se cotiza por WhatsApp'
      : 'Pagar esta reserva ahora';
  }

  botonPagar.addEventListener('click', async () => {
    const { servicioId, tamanoId } = seleccionActual();
    botonPagar.disabled = true;
    botonPagar.textContent = 'Conectando con el pago seguro…';
    errorPago.hidden = true;
    try {
      const res = await fetch('/api/pago/crear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: 'reserva', servicioId, tamanoId }),
      });
      const datos = await res.json();
      if (!res.ok) throw new Error(datos.error || 'No se pudo iniciar el pago.');
      window.location.href = datos.url;
    } catch (e) {
      errorPago.textContent = e.message || 'Error inesperado. Intenta de nuevo.';
      errorPago.hidden = false;
      botonPagar.disabled = false;
      botonPagar.textContent = 'Pagar esta reserva ahora';
    }
  });

  // Cada tipo de evento usa su propio namespace de Cal: así cambiar de
  // servicio monta un embed nuevo sin pelearse con el anterior.
  // Cal.com avisa que no pudo cargar poniendo loading="failed" en el
  // <cal-inline>, pero puede tardar bastante con conexión lenta — que es
  // justo el caso de la clienta en su teléfono. Por eso NO se revisa una sola
  // vez con setTimeout (si el fallo llegaba tarde, el aviso no aparecía
  // nunca): se observa el atributo hasta que cambie.
  let observadorCal = null;

  function vigilarFalloDelEmbed(versionActual) {
    if (observadorCal) observadorCal.disconnect();

    const revisar = () => {
      // Si mientras tanto se montó otro calendario, este chequeo ya no vale.
      if (versionActual !== versionCalendario) {
        if (observadorCal) observadorCal.disconnect();
        return true;
      }
      const embed = contenedor.querySelector('cal-inline');
      if (!embed || embed.getAttribute('loading') !== 'failed') return false;
      contenedor.hidden = true;
      avisoCaido.hidden = false;
      if (observadorCal) observadorCal.disconnect();
      return true;
    };

    // Por si el embed ya venía marcado como fallido antes de observar.
    if (revisar()) return;

    observadorCal = new MutationObserver(revisar);
    observadorCal.observe(contenedor, {
      subtree: true,
      childList: true,
      attributes: true,
      attributeFilter: ['loading'],
    });
  }

  function montarCalendario() {
    const { servicio } = seleccionActual();
    const ns = servicio.slug;
    const versionActual = ++versionCalendario;
    // Volver al estado "cargando": si el servicio anterior había fallado, el
    // nuevo merece su propia oportunidad.
    avisoCaido.hidden = true;
    contenedor.hidden = false;
    contenedor.replaceChildren();
    Cal('init', ns, { origin: 'https://cal.com' });
    window.Cal.ns[ns]('inline', {
      elementOrSelector: contenedor,
      calLink: `${datos.usuario}/${servicio.slug}`,
      layout: 'month_view',
    });
    window.Cal.ns[ns]('ui', {
      styles: { branding: { brandColor: '#2f6b40' } },
    });

    vigilarFalloDelEmbed(versionActual);
  }

  // Preselección vía /reservar/?servicio=bano-corte (enlaces de /servicios)
  const preseleccion = new URLSearchParams(location.search).get('servicio');
  if (preseleccion) {
    const input = document.querySelector(`input[name="servicio"][value="${CSS.escape(preseleccion)}"]`);
    if (input) input.checked = true;
  }

  form.addEventListener('change', (e) => {
    actualizarReferencia();
    actualizarBotonPagar();
    actualizarEnlaceWa();
    if (e.target.name === 'servicio') montarCalendario();
  });

  actualizarReferencia();
  actualizarBotonPagar();
  actualizarEnlaceWa();
  montarCalendario();
</script>

<style>
  .encabezado {
    padding-block: var(--espacio-xl) var(--espacio-l);
    max-width: 65ch;

    & p {
      margin-block-start: var(--espacio-m);
      color: var(--color-texto-suave);
    }
  }

  .politicas {
    margin-block-start: var(--espacio-m);
    padding-inline-start: 1.2em;
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
    display: grid;
    gap: var(--espacio-xs);
  }

  .selector {
    display: grid;
    gap: var(--espacio-m);
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  legend {
    font-weight: 700;
    margin-block-end: var(--espacio-s);
  }

  .pildoras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-s);
  }

  .pildoras label {
    display: grid;
    gap: 0.1rem;
    padding: var(--espacio-s) var(--espacio-m);
    border: 2px solid var(--color-borde);
    border-radius: var(--radio-m);
    background: var(--color-superficie);
    cursor: pointer;

    & small {
      color: var(--color-texto-suave);
    }

    &:has(input:checked) {
      border-color: var(--color-primario);
      background: var(--color-primario-suave);
    }

    &:has(input:focus-visible) {
      outline: 3px solid var(--color-primario);
      outline-offset: 2px;
    }
  }

  /* El radio nativo se oculta; la píldora entera es el control */
  .pildoras input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .referencia {
    margin-block: var(--espacio-m);
    padding: var(--espacio-s) var(--espacio-m);
    border-inline-start: 4px solid var(--color-acento);
    background: var(--color-acento-suave);
    border-radius: var(--radio-s);
    font-weight: 600;
  }

  .aviso-retracto {
    font-size: var(--texto-s);
    font-weight: 600;
  }

  .pagar-online {
    margin-block-end: var(--espacio-l);
    padding: var(--espacio-l);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);

    & h2 {
      font-size: var(--texto-l);
      margin-block-end: var(--espacio-s);
    }

    & .opcional {
      font-size: var(--texto-s);
      font-weight: 400;
      color: var(--color-texto-suave);
    }

    & p {
      margin-block-end: var(--espacio-m);
      color: var(--color-texto-suave);
    }
  }

  /* `.boton` es inline-flex y le ganaría al atributo hidden. */
  .pagar-online [hidden] {
    display: none;
  }

  .estado-pago {
    font-size: var(--texto-s);
  }

  .error-pago {
    margin-block-start: var(--espacio-m);
    padding: var(--espacio-s) var(--espacio-m);
    border-inline-start: 4px solid var(--color-error);
    background: var(--color-fondo);
    border-radius: var(--radio-s);
  }

  .cal-contenedor {
    min-height: 560px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
    overflow: hidden;
    background: var(--color-superficie);
  }

  .cal-cargando {
    padding: var(--espacio-l);
    color: var(--color-texto-suave);
  }

  .cal-caido {
    padding: var(--espacio-l);
    text-align: center;
    display: grid;
    gap: var(--espacio-m);
    justify-items: center;

    /* Sin esto, `display: grid` le gana al `display: none` que el navegador
       aplica por el atributo `hidden`, y el aviso se vería siempre. */
    &[hidden] {
      display: none;
    }

    & h2 {
      font-size: var(--texto-l);
    }

    & p {
      color: var(--color-texto-suave);
      max-width: 40ch;
    }
  }

  .alternativa {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }
</style>
