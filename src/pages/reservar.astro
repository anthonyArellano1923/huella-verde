---
/**
 * Página de reservas: selector de servicio + widget de Cal.com incrustado.
 *
 * El selector cambia el tipo de evento del widget (cada servicio es un tipo
 * de evento distinto en Cal.com, con su duración y buffer). El tamaño del
 * perro solo actualiza la referencia de precio/duración mostrada — el cobro
 * se hace en el local (rama main).
 *
 * TODO(Anthony): el widget funciona de verdad cuando exista la cuenta
 * Cal.com (Fase 2) y `calcomUsuario` en negocio.ts sea el username real.
 */
import Base from '../layouts/Base.astro';
import { NEGOCIO } from '../data/negocio';
import { SERVICIOS, TAMANOS, DURACION_SERVICIO_MIN, POLITICAS_RESERVA } from '../data/servicios';
import { formatCLP } from '../utils/money';
import { waLinkReserva } from '../utils/whatsapp';

// Datos que necesita el script del cliente, serializados una sola vez.
const datosCliente = {
  usuario: NEGOCIO.calcomUsuario,
  duracionMin: DURACION_SERVICIO_MIN,
  servicios: SERVICIOS.map((s) => ({
    id: s.id,
    slug: s.calcomSlug,
    precioPorTamano: s.precioPorTamano,
  })),
};
---

<Base
  titulo="Reservar hora"
  descripcion="Reserva online tu hora de baño, corte, stripping o deslanado. Eliges el día y la hora, te llega la confirmación al correo."
>
  <div class="contenedor">
    <header class="encabezado">
      <h1>Reservar hora</h1>
      <p>
        Elige el servicio, luego el día y la hora en el calendario. Te llegará
        la confirmación por correo y puedes cancelar o cambiar la hora desde
        el mismo correo.
      </p>
      <ul class="politicas">
        <li>Las reservas se hacen con al menos <strong>{POLITICAS_RESERVA.anticipacionMinimaHoras} horas de anticipación</strong>.</li>
        <li>Cada servicio toma entre 1½ y 2 horas; la última hora del día es a las <strong>{POLITICAS_RESERVA.ultimaHoraInicio}</strong>.</li>
        <li>{POLITICAS_RESERVA.notaHorarioEspecial}</li>
      </ul>
    </header>

    <form class="selector" aria-label="Elige servicio y tamaño de tu perro">
      <fieldset>
        <legend>Servicio</legend>
        <div class="pildoras">
          {
            SERVICIOS.map((s, i) => (
              <label>
                <input type="radio" name="servicio" value={s.id} checked={i === 0} />
                <span>{s.nombre}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend>Tamaño de tu perro</legend>
        <div class="pildoras">
          {
            TAMANOS.map((t, i) => (
              <label>
                <input type="radio" name="tamano" value={t.id} checked={i === 0} />
                <span>{t.nombre}</span>
                <small>{t.descripcion}</small>
              </label>
            ))
          }
        </div>
      </fieldset>
    </form>

    <p class="referencia" id="referencia-precio" aria-live="polite">
      {/* El script rellena esto: "Baño completo, perro pequeño: $12.000, ~45 min" */}
    </p>

    <div id="cal-contenedor" class="cal-contenedor">
      <p class="cal-cargando">Cargando la agenda…</p>
    </div>
    <p class="alternativa">
      ¿No carga la agenda o ningún horario te acomoda?
      <a href={waLinkReserva()} rel="noopener">Escríbenos por WhatsApp</a> y coordinamos.
    </p>
  </div>
</Base>

<script is:inline define:vars={{ datos: datosCliente }}>
  /* — Snippet oficial de Cal.com (embed vanilla) — */
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ['initNamespace', namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  const contenedor = document.getElementById('cal-contenedor');
  const referencia = document.getElementById('referencia-precio');
  const form = document.querySelector('.selector');

  const formatCLP = (n) =>
    new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);

  const nombreServicio = {};
  document.querySelectorAll('input[name="servicio"]').forEach((input) => {
    nombreServicio[input.value] = input.parentElement.textContent.trim();
  });
  const nombreTamano = {};
  document.querySelectorAll('input[name="tamano"]').forEach((input) => {
    nombreTamano[input.value] = input.parentElement.querySelector('span').textContent.trim();
  });

  function seleccionActual() {
    const servicioId = form.elements.servicio.value;
    const tamanoId = form.elements.tamano.value;
    return {
      servicio: datos.servicios.find((s) => s.id === servicioId),
      servicioId,
      tamanoId,
    };
  }

  function actualizarReferencia() {
    const { servicio, servicioId, tamanoId } = seleccionActual();
    const precio = servicio.precioPorTamano[tamanoId];
    referencia.textContent =
      `${nombreServicio[servicioId]}, perro ${nombreTamano[tamanoId].toLowerCase()}: ` +
      `${formatCLP(precio)}, entre 1½ y 2 horas. Se paga en el local.`;
  }

  // Cada tipo de evento usa su propio namespace de Cal: así cambiar de
  // servicio monta un embed nuevo sin pelearse con el anterior.
  function montarCalendario() {
    const { servicio } = seleccionActual();
    const ns = servicio.slug;
    contenedor.replaceChildren();
    Cal('init', ns, { origin: 'https://cal.com' });
    window.Cal.ns[ns]('inline', {
      elementOrSelector: contenedor,
      calLink: `${datos.usuario}/${servicio.slug}`,
      layout: 'month_view',
    });
    window.Cal.ns[ns]('ui', {
      styles: { branding: { brandColor: '#c06b3e' } },
    });
  }

  // Preselección vía /reservar/?servicio=bano-corte (enlaces de /servicios)
  const preseleccion = new URLSearchParams(location.search).get('servicio');
  if (preseleccion) {
    const input = document.querySelector(`input[name="servicio"][value="${CSS.escape(preseleccion)}"]`);
    if (input) input.checked = true;
  }

  form.addEventListener('change', (e) => {
    actualizarReferencia();
    if (e.target.name === 'servicio') montarCalendario();
  });

  actualizarReferencia();
  montarCalendario();
</script>

<style>
  .encabezado {
    padding-block: var(--espacio-xl) var(--espacio-l);
    max-width: 65ch;

    & p {
      margin-block-start: var(--espacio-m);
      color: var(--color-texto-suave);
    }
  }

  .politicas {
    margin-block-start: var(--espacio-m);
    padding-inline-start: 1.2em;
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
    display: grid;
    gap: var(--espacio-xs);
  }

  .selector {
    display: grid;
    gap: var(--espacio-m);
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  legend {
    font-weight: 700;
    margin-block-end: var(--espacio-s);
  }

  .pildoras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-s);
  }

  .pildoras label {
    display: grid;
    gap: 0.1rem;
    padding: var(--espacio-s) var(--espacio-m);
    border: 2px solid var(--color-borde);
    border-radius: var(--radio-m);
    background: var(--color-superficie);
    cursor: pointer;

    & small {
      color: var(--color-texto-suave);
    }

    &:has(input:checked) {
      border-color: var(--color-primario);
      background: var(--color-primario-suave);
    }

    &:has(input:focus-visible) {
      outline: 3px solid var(--color-primario);
      outline-offset: 2px;
    }
  }

  /* El radio nativo se oculta; la píldora entera es el control */
  .pildoras input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .referencia {
    margin-block: var(--espacio-m);
    padding: var(--espacio-s) var(--espacio-m);
    border-inline-start: 4px solid var(--color-acento);
    background: var(--color-acento-suave);
    border-radius: var(--radio-s);
    font-weight: 600;
  }

  .cal-contenedor {
    min-height: 560px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
    overflow: hidden;
    background: var(--color-superficie);
  }

  .cal-cargando {
    padding: var(--espacio-l);
    color: var(--color-texto-suave);
  }

  .alternativa {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }
</style>
