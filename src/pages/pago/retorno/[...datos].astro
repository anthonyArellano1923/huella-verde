---
/**
 * Página de retorno de pagos con tarjeta (prerender = false: corre en el
 * servidor en cada visita, porque debe VERIFICAR el pago con la pasarela
 * real, nunca confiar en los query params que trae el navegador).
 *
 * Ruta /pago/retorno/[...datos]: Webpay vuelve a /pago/retorno/<pedido>/<firma>
 * (el pedido firmado sirve para el aviso a Martha, ver pasarelas/webpay.ts);
 * MercadoPago vuelve a /pago/retorno?ref=... Una sola página para ambas:
 * procesarRetorno() detecta la pasarela por los parámetros de la vuelta,
 * verifica, avisa a Martha la primera vez y entrega un resultado normalizado.
 */
import Base from '../../../layouts/Base.astro';
import { NEGOCIO } from '../../../data/negocio';
import { formatCLP } from '../../../utils/money';
import { waLink } from '../../../utils/whatsapp';
import { procesarRetorno, type EstadoPago } from '../../../lib/pasarela';
import { resumenEntrega } from '../../../data/terminos';

export const prerender = false;

const ruta = (Astro.params.datos ?? '').split('/').filter(Boolean);
const { pasarela, resultado } = await procesarRetorno(Astro.request, Astro.url, ruta);
const { estado, detalle } = resultado;
const nombrePasarela = pasarela?.nombre ?? 'el pago online';

const esReserva = detalle?.referencia.includes('-RS-') ?? false;
const waComprobante = detalle
  ? waLink(
      `¡Hola! Acabo de pagar con ${nombrePasarela} en la web de ${NEGOCIO.nombre}.\n` +
        `Referencia: ${detalle.referencia}\n` +
        `Monto: ${formatCLP(detalle.monto)}\n` +
        (esReserva
          ? 'Es el pago de una reserva — te confirmo la hora que agendé.'
          : 'Es una compra de la tienda — ¿coordinamos la entrega?')
    )
  : '';

const titulos: Record<EstadoPago, string> = {
  aprobado: '¡Pago aprobado! 🎉',
  pendiente: 'Pago en proceso',
  rechazado: 'Pago rechazado',
  anulado: 'Pago anulado',
  expirado: 'Se acabó el tiempo para pagar',
  invalido: 'Página de retorno de pagos',
  error: 'No pudimos confirmar tu pago',
};
---

<Base titulo={titulos[estado]} descripcion={`Resultado de tu pago con ${nombrePasarela}.`}>
  <div class="contenedor resultado">
    <h1>{titulos[estado]}</h1>

    {
      (estado === 'aprobado' || estado === 'pendiente') && detalle && (
        <>
          <dl class:list={['voucher', { pendiente: estado === 'pendiente' }]}>
            <div>
              <dt>Referencia</dt>
              <dd>{detalle.referencia}</dd>
            </div>
            <div>
              <dt>Monto</dt>
              <dd>{formatCLP(detalle.monto)}</dd>
            </div>
            <div>
              <dt>Medio de pago</dt>
              <dd>{detalle.medio}</dd>
            </div>
            <div>
              <dt>Comprobante</dt>
              <dd>{detalle.comprobante}</dd>
            </div>
          </dl>

          {estado === 'pendiente' && (
            <p class="nota-pendiente">
              Tu pago está en proceso (por ejemplo, pago en efectivo o
              transferencia que tarda en acreditarse). Te llegará una
              confirmación cuando se apruebe.
            </p>
          )}

          {esReserva ? (
            <div class="siguiente">
              <h2>Último paso: elige tu hora</h2>
              <p>
                Tu pago quedó registrado con la referencia <strong>{detalle.referencia}</strong>.
                Ahora agenda la hora en el calendario y <strong>escribe esta referencia en las
                notas de la reserva</strong> para que Martha la asocie a tu pago.
              </p>
              <a class="boton" href="/reservar/">Agendar mi hora →</a>
            </div>
          ) : (
            <div class="siguiente">
              <h2>¿Y ahora?</h2>
              <p>
                Guarda pantallazo de esta página. {resumenEntrega()} Escríbenos
                por WhatsApp para coordinar la entrega. Las condiciones de cambios
                y devoluciones están en <a href="/terminos/">Términos y condiciones</a>.
              </p>
              <a class="boton boton--whatsapp" href={waComprobante} rel="noopener">
                Coordinar entrega por WhatsApp
              </a>
            </div>
          )}

          {estado === 'aprobado' && !esReserva && <p class="script-carrito" data-limpiar-carrito="" />}
        </>
      )
    }

    {
      estado === 'rechazado' && (
        <p>
          El pago no fue autorizado (fondos, cupo o datos del medio de pago).
          No se descontó dinero. Puedes <a href="/carrito/">intentar de nuevo</a> con
          otro medio (también por transferencia), o <a href="/">volver al inicio</a>.
        </p>
      )
    }

    {
      estado === 'anulado' && (
        <p>
          Cancelaste el pago — no se cobró nada.
          Tu carrito sigue guardado si quieres <a href="/carrito/">retomarlo</a>.
        </p>
      )
    }

    {
      estado === 'expirado' && (
        <p>
          El formulario de pago estuvo abierto demasiado tiempo y se cerró por
          seguridad. No se cobró nada. Tu carrito sigue guardado: puedes
          <a href="/carrito/">intentarlo de nuevo</a>.
        </p>
      )
    }

    {
      estado === 'error' && (
        <p>
          Ocurrió un problema al confirmar con {nombrePasarela}. <strong>Si viste el
          comprobante de pago, tu pago probablemente se realizó</strong> —
          escríbenos por <a href={waLink(`Hola, pagué con ${nombrePasarela} en la web de ${NEGOCIO.nombre} pero la confirmación falló. ¿Me ayudan a verificar?`)} rel="noopener">WhatsApp</a> y
          lo verificamos al tiro. Si no alcanzaste a pagar, intenta de nuevo.
        </p>
      )
    }

    {
      estado === 'invalido' && (
        <p>
          Esta página muestra el resultado de un pago online. Si llegaste
          aquí por error, <a href="/">vuelve al inicio</a>.
        </p>
      )
    }
  </div>
</Base>

<script>
  // Si el pago de PRODUCTOS fue aprobado, el carrito ya no corresponde.
  // (Las reservas no tocan el carrito.)
  if (document.querySelector('[data-limpiar-carrito]')) {
    localStorage.removeItem('mm-carrito');
  }
</script>

<style>
  .resultado {
    padding-block: var(--espacio-xl);
    max-width: 42rem;

    & h1 {
      margin-block-end: var(--espacio-l);
    }

    & p {
      color: var(--color-texto-suave);
    }
  }

  .voucher {
    display: grid;
    gap: var(--espacio-m);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0 0 var(--espacio-l);
    padding: var(--espacio-l);
    background: var(--color-superficie);
    border: 2px solid var(--color-exito);
    border-radius: var(--radio-m);

    &.pendiente {
      border-color: var(--color-acento);
    }

    & dt {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
    }

    & dd {
      margin: 0;
      font-weight: 700;
      overflow-wrap: anywhere;
    }
  }

  .nota-pendiente {
    margin-block-end: var(--espacio-l);
  }

  .siguiente {
    padding: var(--espacio-l);
    background: var(--color-acento-suave);
    border-radius: var(--radio-m);

    & h2 {
      font-size: var(--texto-l);
      margin-block-end: var(--espacio-s);
    }

    & p {
      margin-block-end: var(--espacio-m);
      color: var(--color-texto);
    }
  }

  .script-carrito {
    display: none;
  }
</style>
