---
/**
 * Página de detalle de una prenda. El botón "Lo quiero" abre WhatsApp con el
 * mensaje pre-armado (v1 de venta según PLAN.md — la rama transbank agrega
 * el pago online).
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatCLP } from '../../utils/money';
import { waLinkPrenda } from '../../utils/whatsapp';
import BotonAgregarCarrito from '../../components/react/BotonAgregarCarrito';
import { NEGOCIO } from '../../data/negocio';

export async function getStaticPaths() {
  const prendas = await getCollection('prendas');
  return prendas.map((prenda) => ({
    params: { slug: prenda.id },
    props: { prenda },
  }));
}

const { prenda } = Astro.props;
const { nombre, descripcion, talla, precio, foto, fotoAlt, stock, temporada } = prenda.data;
const { Content } = await render(prenda);
const agotada = stock === 0;
const etiquetaTemporada = { invierno: 'Invierno', verano: 'Verano', 'todo-el-año': 'Todo el año' }[temporada];
---

<Base titulo={nombre} descripcion={descripcion}>
  <div class="contenedor detalle">
    <nav aria-label="Miga de pan" class="miga">
      <a href="/ropita/">← Volver al catálogo</a>
    </nav>

    <article>
      <div class="foto">
        <Image src={foto} alt={fotoAlt} width={800} height={800} loading="eager" />
      </div>

      <div class="info">
        <span class="sello-hechoamano">
          <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <path d="M12,21 C12,21 3,14 3,8 C3,5 5,3.5 7.2,3.5 C9,3.5 11,5 12,7 C13,5 15,3.5 16.8,3.5 C19,3.5 21,5 21,8 C21,14 12,21 12,21 Z" />
          </svg>
          Tejido a mano por {NEGOCIO.duena}
        </span>
        <h1>{nombre}</h1>
        <p class="precio">{formatCLP(precio)}</p>
        <dl class="datos">
          <div>
            <dt>Talla</dt>
            <dd>{talla}</dd>
          </div>
          <div>
            <dt>Temporada</dt>
            <dd>{etiquetaTemporada}</dd>
          </div>
          <div>
            <dt>Disponibles</dt>
            <dd>{agotada ? 'Agotada 😢' : stock}</dd>
          </div>
        </dl>

        <p>{descripcion}</p>

        {
          agotada ? (
            <p class="aviso-agotada">
              Esta prenda ya se vendió, pero Martha puede tejer algo parecido a
              pedido. <a href={waLinkPrenda(nombre, talla, precio)} rel="noopener">Pregúntale por WhatsApp</a>.
            </p>
          ) : (
            <>
              <BotonAgregarCarrito
                client:load
                slug={prenda.id}
                nombre={nombre}
                talla={talla}
                precio={precio}
                stock={stock}
              />
              <p class="nota-pago">
                Pago online con MercadoPago. La entrega se coordina después
                del pago: retiro en la peluquería o encomienda.
              </p>
              <a class="enlace-whatsapp" href={waLinkPrenda(nombre, talla, precio)} rel="noopener">
                ¿Prefieres transferencia? Coordina por WhatsApp →
              </a>
            </>
          )
        }

        <div class="cuerpo">
          <Content />
        </div>
      </div>
    </article>
  </div>
</Base>

<style>
  .detalle {
    padding-block-start: var(--espacio-l);
  }

  .miga {
    margin-block-end: var(--espacio-m);
    font-size: var(--texto-s);
  }

  article {
    display: grid;
    gap: var(--espacio-l);

    /* En pantallas anchas: foto e info lado a lado */
    @media (width >= 48rem) {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .foto img {
    width: 100%;
    border-radius: var(--radio-m);
    border: 1px solid var(--color-borde);
  }

  .info > .sello-hechoamano {
    margin-block-end: var(--espacio-s);
  }

  .precio {
    font-size: var(--texto-xl);
    font-weight: 700;
    color: var(--color-primario-fuerte);
    margin-block: var(--espacio-s) var(--espacio-m);
  }

  .datos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-m) var(--espacio-l);
    margin-block-end: var(--espacio-m);
    padding: var(--espacio-m);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2);

    & dt {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
    }

    & dd {
      margin: 0;
      font-weight: 700;
    }
  }

  .boton {
    margin-block-start: var(--espacio-m);
    margin-inline-end: var(--espacio-s);
  }

  .nota-pago {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .enlace-whatsapp {
    display: inline-block;
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
  }

  .aviso-agotada {
    margin-block-start: var(--espacio-m);
    padding: var(--espacio-m);
    border-inline-start: 4px solid var(--color-error);
    background: var(--color-superficie);
    border-radius: var(--radio-s);
  }

  .cuerpo {
    margin-block-start: var(--espacio-l);
    color: var(--color-texto-suave);
  }
</style>

<style is:global>
  /* Estilos de la isla BotonAgregarCarrito */
  .agregar-carrito {
    margin-block-start: var(--espacio-m);

    & .boton[disabled] {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .en-carrito {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    font-weight: 600;
  }
</style>
