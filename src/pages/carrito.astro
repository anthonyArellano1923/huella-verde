---
/**
 * Página del carrito: la lista interactiva y los botones de pago (tarjeta o
 * transferencia) son una isla React (client:load).
 */
import Base from '../layouts/Base.astro';
import CarritoLista from '../components/react/CarritoLista';
import { TERMINOS, resumenEntrega } from '../data/terminos';
---

<Base titulo="Tu carrito" descripcion="Revisa tu pedido y paga online de forma segura.">
  <div class="contenedor pagina-carrito">
    <h1>Tu carrito</h1>
    {/* Reserved height: the island renders only on the client (cart lives in
        localStorage), so without it the footer jumps when the list appears. */}
    <div class="carrito-isla">
      <CarritoLista client:only="react" />
    </div>
    {/* Ley 19.496 art. 3 bis: the retracto exclusion must be shown before paying. */}
    {TERMINOS.retracto.excluirPlantas && (
      <p class="alternativa">
        Por ser perecibles, las plantas no tienen derecho a retracto.{' '}
        <a href="/terminos/#garantia">Cambios y devoluciones</a>
      </p>
    )}
    <p class="alternativa">
      {resumenEntrega()} La entrega se coordina después del pago.
    </p>
  </div>
</Base>

<style is:global>
  /* Estilos de la isla CarritoLista (el CSS de las islas vive en la página) */
  .pagina-carrito {
    padding-block: var(--espacio-xl);
    max-width: 42rem;

    & h1 {
      margin-block-end: var(--espacio-l);
    }
  }

  .carrito-isla {
    min-block-size: 12rem;
  }

  .carrito-vacio {
    color: var(--color-texto-suave);
  }

  .carrito__lista {
    display: grid;
    gap: var(--espacio-s);
    margin: 0 0 var(--espacio-m);
    padding: 0;
    list-style: none;

    & li {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--espacio-s);
      padding: var(--espacio-m);
      background: var(--color-superficie);
      border: 1px solid var(--color-borde);
      border-radius: var(--radio-m);
    }

    & small {
      color: var(--color-texto-suave);
    }
  }

  .carrito__controles {
    display: flex;
    align-items: center;
    gap: var(--espacio-s);

    & button {
      /* 44 px touch target (WCAG 2.5.5) and a border with >= 3:1 contrast */
      inline-size: 2.75rem;
      block-size: 2.75rem;
      border: 1px solid var(--color-texto-suave);
      border-radius: var(--radio-s);
      background: var(--color-fondo);
      color: var(--color-texto);
      font-size: 1.1rem;
      cursor: pointer;

      &:hover {
        background: var(--color-primario-suave);
      }
    }

    & strong {
      min-inline-size: 5.5rem;
      text-align: right;
    }
  }

  .carrito__total {
    font-size: var(--texto-l);
    margin-block-end: var(--espacio-m);
  }

  .carrito__error {
    padding: var(--espacio-s) var(--espacio-m);
    border-inline-start: 4px solid var(--color-error);
    background: var(--color-superficie);
    border-radius: var(--radio-s);
    margin-block-end: var(--espacio-m);
  }

  .carrito__pagos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-s);
  }

  .carrito__nota {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .alternativa {
    margin-block-start: var(--espacio-l);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }
</style>
