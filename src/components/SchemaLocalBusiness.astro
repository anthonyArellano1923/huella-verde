---
/**
 * Datos estructurados Schema.org (JSON-LD) para SEO local: le dicen a Google
 * "esto es un negocio físico, con esta dirección y estos horarios", lo que
 * habilita el panel de negocio en los resultados de búsqueda (Fase 6).
 */
import { NEGOCIO, WHATSAPP_WA } from '../data/negocio';

const consultaMapa = encodeURIComponent(
  `${NEGOCIO.direccion.calle}, ${NEGOCIO.direccion.comuna}, ${NEGOCIO.direccion.ciudad}`
);
const mapaUrl = `https://www.google.com/maps/search/?api=1&query=${consultaMapa}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'PetStore'],
  '@id': NEGOCIO.url,
  name: NEGOCIO.nombre,
  description: NEGOCIO.descripcion,
  url: NEGOCIO.url,
  telephone: `+${WHATSAPP_WA}`,
  email: NEGOCIO.email,
  image: new URL('/og-image.jpg', NEGOCIO.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: NEGOCIO.direccion.calle,
    addressLocality: NEGOCIO.direccion.comuna,
    addressRegion: NEGOCIO.direccion.region,
    addressCountry: 'CL',
  },
  hasMap: mapaUrl,
  openingHours: NEGOCIO.horariosSchema,
  priceRange: '$$',
  // TODO(Anthony): agregar sameAs cuando exista una URL real de Instagram.
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
