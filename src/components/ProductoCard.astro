---
/**
 * Product card for the shop grids (/plantas and /accesorios).
 *
 * Shows the real photo when the entry has one (optimized by astro:assets);
 * otherwise falls back to the code-drawn illustration for its `ilustracion`
 * id. Plants show light/care chips; accessories show their category.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ilustracion from './ilustraciones/Ilustracion.astro';
import AgregarRapido from './AgregarRapido.astro';
import { miniaturaProducto } from '../utils/miniatura';
import { formatCLP } from '../utils/money';
import { ETIQUETA_CATEGORIA, ETIQUETA_DIFICULTAD } from './producto-etiquetas';

interface Props {
  producto: CollectionEntry<'plantas'> | CollectionEntry<'accesorios'>;
  /**
   * Heading level of the product name. 2 on a flat grid (/plantas); 3 when
   * the grid sits under section h2s (/accesorios), so the outline nests.
   */
  nivel?: 2 | 3;
}

const { producto, nivel = 2 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
const { nombre, descripcion, precio, foto, fotoAlt, stock, ilustracion } = producto.data;
const agotado = stock === 0;
const href = `/${producto.collection}/${producto.id}/`;
const miniatura = await miniaturaProducto(foto, ilustracion);

/** Small chips under the description: care level for plants, category for accessories. */
const chips: string[] =
  producto.collection === 'plantas'
    ? [
        ETIQUETA_DIFICULTAD[producto.data.dificultad],
        ...(producto.data.nativa ? ['Nativa'] : []),
        ...(producto.data.petFriendly ? ['Apta mascotas'] : []),
      ]
    : [ETIQUETA_CATEGORIA[producto.data.categoria]];
---

<article class:list={['tarjeta', { agotado }]}>
  <a href={href}>
    <div class="imagen">
      {
        foto ? (
          <Image src={foto} alt={fotoAlt} width={600} height={600} loading="lazy" />
        ) : (
          <div class="ilustracion-marco" role="img" aria-label={fotoAlt}>
            <Ilustracion id={ilustracion} />
          </div>
        )
      }
      {agotado && <span class="etiqueta">Agotado</span>}
    </div>
    <div class="info">
      <Titulo class="nombre">{nombre}</Titulo>
      {producto.collection === 'plantas' && <p class="cientifico">{producto.data.nombreCientifico}</p>}
      <p class="descripcion">{descripcion}</p>
      <ul class="chips" aria-label="Características">
        {chips.map((chip) => <li>{chip}</li>)}
      </ul>
      <p class="precio">{formatCLP(precio)}</p>
    </div>
  </a>
  {/* Outside the link: a button cannot live inside an <a>. */}
  <AgregarRapido id={`${producto.collection}/${producto.id}`} nombre={nombre} precio={precio} stock={stock} miniatura={miniatura} />
</article>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2.2);
    overflow: hidden;
    box-shadow: var(--sombra-tarjeta);
    transition: transform 0.18s ease, box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 22px oklch(0.4 0.06 155 / 0.14);
    }

    & > a {
      display: flex;
      flex: 1;
      flex-direction: column;
      font-weight: inherit;
      color: inherit;
      text-decoration: none;

      /* The card clips overflow (rounded image corners), so the global
         outline drawn around the link would be cut off and the positioned
         image would paint over an inset one. The card draws the ring. */
      &:focus-visible {
        outline: none;
      }
    }

    /* Same ring as the global :focus-visible, on the card's own edge */
    &:has(> a:focus-visible) {
      outline: 3px solid var(--color-primario);
      outline-offset: 2px;
    }
  }

  .imagen {
    position: relative;
    aspect-ratio: 1;
    background: var(--color-primario-suave);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .ilustracion-marco {
    width: 100%;
    height: 100%;
  }

  /* Fade only the picture: the "Agotado" badge must keep full contrast */
  .agotado .imagen > :not(.etiqueta) {
    opacity: 0.55;
  }

  .etiqueta {
    position: absolute;
    top: var(--espacio-s);
    right: var(--espacio-s);
    padding: 0.2em 0.8em;
    border-radius: var(--radio-pill);
    background: var(--color-error);
    /* Fixed light text: --color-error does not change in dark mode */
    color: var(--color-texto-sobre-color);
    font-size: var(--texto-s);
    font-weight: 700;
  }

  .info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--espacio-m);
  }

  .nombre {
    font-size: var(--texto-base);
  }

  .cientifico {
    font-size: var(--texto-s);
    font-style: italic;
    color: var(--color-texto-suave);
  }

  .descripcion {
    margin-block: var(--espacio-xs);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-xs);
    margin-block: var(--espacio-s);
    padding: 0;
    list-style: none;

    & li {
      font-size: var(--texto-s);
      padding: 0.1em 0.7em;
      border-radius: var(--radio-pill);
      background: var(--color-acento-suave);
      color: var(--color-acento-fuerte);
      font-weight: 600;
    }
  }

  .precio {
    margin-block-start: auto;
    font-weight: 700;
    color: var(--color-primario-fuerte);
  }
</style>
