---
/**
 * Tabla de precios servicio × tamaño. Se alimenta 100% de src/data/servicios.ts:
 * cambiar un precio allá actualiza esta tabla, la página de reservas y el
 * checkout de la rama transbank. La duración no va por celda porque Martha
 * definió un bloque único (1,5–2 h) para todos los servicios.
 */
import { SERVICIOS, TAMANOS, SERVICIOS_EXPRESS, POLITICAS_RESERVA } from '../data/servicios';
import { formatCLP } from '../utils/money';
---

<div class="envoltorio" tabindex="0" role="region" aria-label="Tabla de precios por servicio y tamaño de perro">
  <table>
    <caption class="visualmente-oculto">
      Precios de cada servicio según el tamaño del perro
    </caption>
    <thead>
      <tr>
        <th scope="col">Servicio</th>
        {TAMANOS.map((t) => <th scope="col">{t.nombre}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        SERVICIOS.map((s) => (
          <tr>
            <th scope="row">{s.nombre}</th>
            {TAMANOS.map((t) => (
              <td>
                {s.precioDesdePorTamano ? (
                  <>
                    <span class="desde">desde </span>
                    <strong>{formatCLP(s.precioDesdePorTamano[t.id])}</strong>
                  </>
                ) : (
                  <span class="consultar">A consultar</span>
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="nota-duracion">
  Cada servicio toma entre <strong>1½ y 2 horas</strong> — tu perrito se
  atiende con calma, sin apuros. {POLITICAS_RESERVA.notaPrecios}
</p>

<section class="express" aria-labelledby="titulo-express">
  <h2 id="titulo-express">Servicios express (~5 min)</h2>
  <p>Se hacen al momento en el local, sin reserva. El valor se cotiza ahí mismo.</p>
  <ul>
    {SERVICIOS_EXPRESS.map((e) => <li>{e.nombre}</li>)}
  </ul>
</section>

<style>
  /* La tabla scrollea horizontal en pantallas chicas, la página nunca */
  .envoltorio {
    overflow-x: auto;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
    background: var(--color-superficie);
  }

  table {
    width: 100%;
    min-width: 30rem;
    border-collapse: collapse;
    font-size: var(--texto-s);
  }

  th,
  td {
    padding: var(--espacio-s) var(--espacio-m);
    text-align: left;
    border-block-end: 1px solid var(--color-borde);
  }

  tbody tr:last-child :is(th, td) {
    border-block-end: none;
  }

  thead th {
    background: var(--color-primario-suave);
    color: var(--color-primario-fuerte);
  }

  tbody th {
    font-weight: 600;
  }

  .nota-duracion {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .desde {
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  td strong {
    display: block;
  }

  .consultar {
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
    font-style: italic;
  }

  .express {
    margin-block-start: var(--espacio-l);
    padding: var(--espacio-l);
    background: var(--color-acento-suave);
    border-radius: var(--radio-m);

    & h2 {
      font-size: var(--texto-base);
      margin-block-end: var(--espacio-xs);
    }

    & p {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
      margin-block-end: var(--espacio-s);
    }

    & ul {
      margin: 0;
      padding-inline-start: 1.2em;
      font-size: var(--texto-s);
    }
  }
</style>
