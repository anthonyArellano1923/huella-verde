---
import { NEGOCIO } from '../data/negocio';
import { waLinkConsulta } from '../utils/whatsapp';
import IconoGrooming from './IconoGrooming.astro';
import SelectorTema from './SelectorTema.astro';

const anio = new Date().getFullYear();
---

<footer>
  {/* Rastro de huellitas cruzando el borde superior */}
  <div class="rastro" aria-hidden="true">
    {
      Array.from({ length: 6 }).map((_, i) => (
        <IconoGrooming tipo="huella" size={22} class:list={['huellita', { 'huellita--baja': i % 2 === 1 }]} />
      ))
    }
  </div>

  <div class="contenedor marca-footer">
    <p class="marca-footer__nombre">{NEGOCIO.nombre}</p>
    <p>
      Peluquería canina y tienda de plantas · {NEGOCIO.direccion.calle}, {NEGOCIO.direccion.comuna}
    </p>
  </div>

  <div class="contenedor columnas">
    <section aria-labelledby="pie-peluqueria" class="col col--peluqueria">
      <h2 id="pie-peluqueria">Peluquería</h2>
      <ul>
        <li><a href="/servicios/">Servicios y precios</a></li>
        <li><a href="/reservar/">Reservar hora</a></li>
      </ul>
      <h3>Horarios</h3>
      <ul>
        {
          NEGOCIO.horarios.map((h) => (
            <li>
              <strong>{h.dias}:</strong> {h.horas}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="pie-tienda" class="col col--tienda">
      <h2 id="pie-tienda">Tienda</h2>
      <ul>
        <li><a href="/plantas/">Plantas</a></li>
        <li><a href="/accesorios/">Accesorios y cuidado</a></li>
      </ul>
    </section>

    <section aria-labelledby="pie-contacto" class="col">
      <h2 id="pie-contacto">Contacto</h2>
      <ul>
        <li>
          <a href={waLinkConsulta()} rel="noopener">WhatsApp</a>
        </li>
        <li>
          <a href={`mailto:${NEGOCIO.email}`}>{NEGOCIO.email}</a>
        </li>
        <li>
          <a href="/terminos/">Términos y privacidad</a>
        </li>
      </ul>
      <address>
        {NEGOCIO.direccion.calle}, {NEGOCIO.direccion.comuna}<br />
        {NEGOCIO.direccion.region}
      </address>
    </section>
  </div>

  <div class="contenedor">
    <SelectorTema />
  </div>

  <p class="contenedor legal">© {anio} {NEGOCIO.nombre} · Hecho con cariño en Chile 🇨🇱</p>
</footer>

<style>
  footer {
    position: relative;
    margin-block-start: var(--espacio-2xl);
    padding-block: var(--espacio-xl) var(--espacio-l);
    background: var(--color-superficie);
    border-block-start: 1px solid var(--color-borde);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  /* Rastro de huellitas caminando sobre el borde superior del footer */
  .rastro {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: var(--espacio-l);
    display: flex;
    align-items: center;
    gap: var(--espacio-s);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .rastro :global(.huellita) {
    color: var(--color-primario);
    opacity: 0.3;
    transform: rotate(-24deg);
  }

  .rastro :global(.huellita--baja) {
    transform: translateY(35%) rotate(-24deg);
  }

  @media (width < 34rem) {
    .rastro {
      inset-inline: 0;
      justify-content: center;
    }
  }

  .columnas {
    display: grid;
    gap: var(--espacio-l);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .marca-footer {
    margin-block-end: var(--espacio-l);

    & p {
      max-inline-size: 48ch;
    }
  }

  .marca-footer__nombre {
    font-family: var(--fuente-titulos);
    font-size: var(--texto-l);
    font-weight: 700;
    color: var(--color-texto);
  }

  /* Cada columna de negocio lleva el color de su vertical en el título */
  h2 {
    font-size: var(--texto-base);
    color: var(--color-texto);
    margin-block-end: var(--espacio-s);
    padding-block-start: var(--espacio-s);
    border-block-start: 3px solid var(--color-borde);
  }

  .col--peluqueria h2 {
    border-color: var(--color-peluqueria);
  }

  .col--tienda h2 {
    border-color: var(--color-tienda);
  }

  h3 {
    margin-block: var(--espacio-m) var(--espacio-xs);
    font-family: var(--fuente-texto);
    font-size: var(--texto-s);
    color: var(--color-texto);
  }

  /* Targets táctiles ≥ 44px en los enlaces del pie */
  li a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }

  address {
    margin-block-start: var(--espacio-s);
    font-style: normal;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--espacio-xs);
  }

  .legal {
    margin-block-start: var(--espacio-l);
    padding-block-start: var(--espacio-m);
    border-block-start: 1px solid var(--color-borde);
    text-align: center;
  }
</style>
