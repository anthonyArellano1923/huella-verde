---
import { NEGOCIO } from '../data/negocio';
import { waLinkConsulta } from '../utils/whatsapp';
import IconoGrooming from './IconoGrooming.astro';

const anio = new Date().getFullYear();
---

<footer>
  {/* Rastro de huellitas cruzando el borde superior */}
  <div class="rastro" aria-hidden="true">
    {
      Array.from({ length: 6 }).map((_, i) => (
        <IconoGrooming tipo="huella" size={22} class:list={['huellita', { 'huellita--baja': i % 2 === 1 }]} />
      ))
    }
  </div>

  <div class="contenedor columnas">
    <section>
      <h2>{NEGOCIO.nombre}</h2>
      <p>{NEGOCIO.slogan}</p>
      <p>
        {NEGOCIO.direccion.calle}, {NEGOCIO.direccion.comuna}<br />
        {NEGOCIO.direccion.ciudad}
      </p>
    </section>

    <section>
      <h2>Horarios</h2>
      <ul>
        {
          NEGOCIO.horarios.map((h) => (
            <li>
              <strong>{h.dias}:</strong> {h.horas}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Contacto</h2>
      <ul>
        <li>
          <a href={waLinkConsulta()} rel="noopener">WhatsApp</a>
        </li>
        <li>
          <a href={`mailto:${NEGOCIO.email}`}>{NEGOCIO.email}</a>
        </li>
      </ul>
    </section>
  </div>

  <p class="contenedor legal">© {anio} {NEGOCIO.nombre} · Hecho con cariño en Chile 🇨🇱</p>
</footer>

<style>
  footer {
    position: relative;
    margin-block-start: var(--espacio-2xl);
    padding-block: var(--espacio-xl) var(--espacio-l);
    background: var(--color-superficie);
    border-block-start: 1px solid var(--color-borde);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  /* Rastro de huellitas caminando sobre el borde superior del footer */
  .rastro {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: var(--espacio-l);
    display: flex;
    align-items: center;
    gap: var(--espacio-s);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .rastro :global(.huellita) {
    color: var(--color-primario);
    opacity: 0.5;
    transform: rotate(-24deg);
  }

  .rastro :global(.huellita--baja) {
    transform: translateY(35%) rotate(-24deg);
  }

  @media (width < 34rem) {
    .rastro {
      inset-inline: 0;
      justify-content: center;
    }
  }

  .columnas {
    display: grid;
    gap: var(--espacio-l);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  h2 {
    font-size: var(--texto-base);
    color: var(--color-texto);
    margin-block-end: var(--espacio-s);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--espacio-xs);
  }

  .legal {
    margin-block-start: var(--espacio-xl);
    padding-block-start: var(--espacio-m);
    border-block-start: 1px solid var(--color-borde);
    text-align: center;
  }
</style>
