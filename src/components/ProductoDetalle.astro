---
/**
 * Detail view shared by /plantas/[slug] and /accesorios/[slug].
 *
 * Renders the photo or illustration, price, key facts, the cart island and a
 * WhatsApp fallback. The cart item id is "<collection>/<slug>" (e.g.
 * "plantas/echeveria") so the checkout can tell shop products apart from
 * the dog-clothing catalog.
 */
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BotonAgregarCarrito from './react/BotonAgregarCarrito';
import Ilustracion from './ilustraciones/Ilustracion.astro';
import { formatCLP } from '../utils/money';
import { waLink } from '../utils/whatsapp';
import { NEGOCIO } from '../data/negocio';
import { TERMINOS, resumenEntrega } from '../data/terminos';
import {
  ETIQUETA_CATEGORIA,
  ETIQUETA_DIFICULTAD,
  ETIQUETA_LUZ,
  ETIQUETA_RIEGO,
} from './producto-etiquetas';

interface Props {
  producto: CollectionEntry<'plantas'> | CollectionEntry<'accesorios'>;
}

const { producto } = Astro.props;
const { nombre, descripcion, precio, foto, fotoAlt, stock, ilustracion } = producto.data;
const { Content } = await render(producto);
const agotado = stock === 0;
const esPlanta = producto.collection === 'plantas';
const idCarrito = `${producto.collection}/${producto.id}`;
const volver = esPlanta
  ? { href: '/plantas/', texto: '← Volver a las plantas' }
  : { href: '/accesorios/', texto: '← Volver a los accesorios' };

/** Key facts shown in the summary box, as [label, value] pairs. */
const datos: [string, string][] =
  producto.collection === 'plantas'
    ? [
        ['Luz', ETIQUETA_LUZ[producto.data.luz]],
        ['Riego', ETIQUETA_RIEGO[producto.data.riego]],
        ['Cuidado', ETIQUETA_DIFICULTAD[producto.data.dificultad]],
        ['Mascotas', producto.data.petFriendly ? 'Apta para perros y gatos' : 'Mantener fuera de su alcance'],
        ['Origen', producto.data.nativa ? 'Nativa de Chile' : 'Introducida'],
      ]
    : [
        ['Categoría', ETIQUETA_CATEGORIA[producto.data.categoria]],
        ['Plantas nativas', producto.data.aptoNativas ? 'Apto' : 'No recomendado'],
      ];
const advertencias = producto.collection === 'accesorios' ? producto.data.advertencias : [];
datos.push(['Disponibles', agotado ? 'Agotado' : String(stock)]);

/**
 * Schema.org Product + Offer (JSON-LD) so search engines can show price and
 * availability. The seller points to the LocalBusiness emitted by Base
 * (same `@id`). Image only when there is a real photo: illustrations are
 * inline SVG and the generic og-image is not a product picture.
 */
const urlProducto = new URL(Astro.url.pathname, NEGOCIO.url).href;
const imagenSchema = foto
  ? new URL((await getImage({ src: foto, width: 1200, format: 'jpg' })).src, NEGOCIO.url).href
  : undefined;
const schemaProducto = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: nombre,
  description: descripcion,
  sku: idCarrito,
  url: urlProducto,
  category: producto.collection === 'accesorios' ? ETIQUETA_CATEGORIA[producto.data.categoria] : 'Plantas',
  ...(imagenSchema && { image: imagenSchema }),
  offers: {
    '@type': 'Offer',
    url: urlProducto,
    price: precio,
    priceCurrency: 'CLP',
    availability: agotado ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@id': NEGOCIO.url },
  },
};
/** JSON for the <script> tag; "<" escaped so text can never close the tag. */
const jsonLdProducto = JSON.stringify(schemaProducto).replace(/</g, '\\u003c');

/**
 * Builds the pre-filled WhatsApp message for this product.
 *
 * @param consulta - true when the product is sold out (asks for restock instead).
 * @returns A wa.me link with the message url-encoded.
 */
function enlaceWhatsApp(consulta: boolean): string {
  const lineas = consulta
    ? [`¡Hola! Vi en la web de ${NEGOCIO.nombre} el producto "${nombre}" y aparece agotado. ¿Cuándo vuelve a llegar?`]
    : [
        `¡Hola! Vi esto en la web de ${NEGOCIO.nombre} y me interesa:`,
        '',
        `• ${nombre} — ${formatCLP(precio)}`,
        '',
        '¿Está disponible? Me gustaría coordinar el pago por transferencia y la entrega.',
      ];
  return waLink(lineas.join('\n'));
}
---

<script type="application/ld+json" set:html={jsonLdProducto} />

<div class="contenedor detalle">
  <nav aria-label="Miga de pan" class="miga">
    <a href={volver.href}>{volver.texto}</a>
  </nav>

  <article>
    <div class="imagen">
      {
        foto ? (
          <Image src={foto} alt={fotoAlt} width={800} height={800} loading="eager" />
        ) : (
          <div class="ilustracion-marco" role="img" aria-label={fotoAlt}>
            <Ilustracion id={ilustracion} />
          </div>
        )
      }
    </div>

    <div class="info">
      <h1>{nombre}</h1>
      {producto.collection === 'plantas' && <p class="cientifico">{producto.data.nombreCientifico}</p>}
      <p class="precio">{formatCLP(precio)}</p>

      <dl class="datos">
        {
          datos.map(([etiqueta, valor]) => (
            <div>
              <dt>{etiqueta}</dt>
              <dd>{valor}</dd>
            </div>
          ))
        }
      </dl>

      <p>{descripcion}</p>

      {
        advertencias.length > 0 && (
          <div class="advertencias">
            <p class="advertencias-titulo">Antes de usarlo</p>
            <ul>
              {advertencias.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        )
      }

      {
        agotado ? (
          <p class="aviso-agotado">
            Por ahora no nos quedan unidades.{' '}
            <a href={enlaceWhatsApp(true)} rel="noopener">Pregúntanos por WhatsApp</a> cuándo vuelve.
          </p>
        ) : (
          <>
            <BotonAgregarCarrito
              client:load
              slug={idCarrito}
              nombre={nombre}
              talla="única"
              precio={precio}
              stock={stock}
            />
            <p class="nota-pago">
              Pago online seguro. {resumenEntrega()} Se coordina después del pago.{' '}
              {/* Ley 19.496 art. 3 bis: la exclusión del retracto debe informarse antes del pago */}
              {esPlanta && TERMINOS.retracto.excluirPlantas && (
                <>Por ser perecibles, las plantas no tienen derecho a retracto. </>
              )}
              <a href="/terminos/#garantia">Cambios y devoluciones</a>
            </p>
            <a class="enlace-whatsapp" href={enlaceWhatsApp(false)} rel="noopener">
              ¿Prefieres transferencia? Pide por WhatsApp →
            </a>
          </>
        )
      }

      <div class="cuerpo">
        <Content />
      </div>
    </div>
  </article>
</div>

<style>
  .detalle {
    padding-block-start: var(--espacio-l);
  }

  .miga {
    margin-block-end: var(--espacio-m);
    font-size: var(--texto-s);

    /* 44 px touch target without changing the visual spacing */
    & a {
      display: inline-block;
      padding-block: 0.9em;
      margin-block: -0.9em;
    }
  }

  article {
    display: grid;
    gap: var(--espacio-l);

    /* Wide screens: image and info side by side */
    @media (width >= 48rem) {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .imagen {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radio-m);
    border: 1px solid var(--color-borde);
    background: var(--color-primario-suave);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .ilustracion-marco {
    width: 100%;
    height: 100%;
  }

  .cientifico {
    font-style: italic;
    color: var(--color-texto-suave);
  }

  .precio {
    font-size: var(--texto-xl);
    font-weight: 700;
    color: var(--color-primario-fuerte);
    margin-block: var(--espacio-s) var(--espacio-m);
  }

  .datos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-m) var(--espacio-l);
    margin-block-end: var(--espacio-m);
    padding: var(--espacio-m);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2);

    & dt {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
    }

    & dd {
      margin: 0;
      font-weight: 700;
    }
  }

  .advertencias {
    margin-block-start: var(--espacio-m);
    padding: var(--espacio-m);
    border-inline-start: 4px solid var(--color-acento);
    background: var(--color-acento-suave);
    border-radius: var(--radio-s);

    & ul {
      margin: var(--espacio-xs) 0 0;
      padding-inline-start: 1.2em;
    }
  }

  .advertencias-titulo {
    font-weight: 700;
  }

  .nota-pago {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .enlace-whatsapp {
    display: inline-block;
    /* 44 px touch target: padding grows the hit area, negative margin keeps the layout */
    padding-block: 0.9em;
    margin-block: calc(var(--espacio-s) - 0.9em) -0.9em;
    font-size: var(--texto-s);
  }

  .aviso-agotado {
    margin-block-start: var(--espacio-m);
    padding: var(--espacio-m);
    border-inline-start: 4px solid var(--color-error);
    background: var(--color-superficie);
    border-radius: var(--radio-s);
  }

  .cuerpo {
    margin-block-start: var(--espacio-l);
    color: var(--color-texto-suave);
  }
</style>

<style is:global>
  /* Styles for the BotonAgregarCarrito island (it renders plain class names) */
  .agregar-carrito {
    margin-block-start: var(--espacio-m);

    & .boton[disabled] {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .en-carrito {
    margin-block-start: var(--espacio-s);
    font-size: var(--texto-s);
    font-weight: 600;
  }
</style>
