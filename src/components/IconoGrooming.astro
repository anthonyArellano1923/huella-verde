---
/**
 * Íconos de peluquería canina (grooming) — SVG vectorial, heredan
 * `currentColor`. Refuerzan la simbología de mascotas y grooming.
 *
 * tipos:
 *  - 'gota'    → gota de agua (baño)
 *  - 'tijeras' → tijeras de corte
 *  - 'peine'   → peine
 *  - 'cepillo' → cepillo/carda
 *  - 'huella'  → huella de perro
 *  - 'perro'   → carita de perrito
 */
interface Props {
  tipo: 'gota' | 'tijeras' | 'peine' | 'cepillo' | 'huella' | 'perro';
  size?: number;
  class?: string;
  title?: string;
}
const { tipo, size = 24, class: clase = '', title = '' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class:list={['icono-grooming', `icono-grooming--${tipo}`, clase]}
  role={title ? 'img' : 'presentation'}
  aria-label={title || undefined}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  {title && <title>{title}</title>}

  {
    tipo === 'gota' && (
      <path
        class="relleno"
        d="M12 2.5 C12 2.5 5 10 5 14.6 A7 7 0 0 0 19 14.6 C19 10 12 2.5 12 2.5 Z"
      />
    )
  }

  {
    tipo === 'tijeras' && (
      <g class="trazo">
        <circle cx="6" cy="6.4" r="2.7" />
        <circle cx="6" cy="17.6" r="2.7" />
        <line x1="8.2" y1="7.7" x2="20" y2="16.6" />
        <line x1="8.2" y1="16.3" x2="20" y2="7.4" />
        <circle class="pivote" cx="12.7" cy="12" r="0.6" />
      </g>
    )
  }

  {
    tipo === 'peine' && (
      <g class="trazo">
        <path d="M3.5 7 h17 v3.2 h-17 z" />
        <line x1="5" y1="10.4" x2="5" y2="17.5" />
        <line x1="8" y1="10.4" x2="8" y2="17.5" />
        <line x1="11" y1="10.4" x2="11" y2="17.5" />
        <line x1="14" y1="10.4" x2="14" y2="17.5" />
        <line x1="17" y1="10.4" x2="17" y2="17.5" />
        <line x1="20" y1="10.4" x2="20" y2="17.5" />
      </g>
    )
  }

  {
    tipo === 'cepillo' && (
      <g class="trazo">
        <rect x="4.5" y="4.5" width="15" height="6" rx="3" />
        <line x1="7" y1="10.5" x2="7" y2="14" />
        <line x1="10" y1="10.5" x2="10" y2="14" />
        <line x1="14" y1="10.5" x2="14" y2="14" />
        <line x1="17" y1="10.5" x2="17" y2="14" />
        <line x1="12" y1="10.5" x2="12" y2="20" />
      </g>
    )
  }

  {
    tipo === 'huella' && (
      <g class="relleno">
        <ellipse cx="12" cy="15.4" rx="4.4" ry="3.7" />
        <ellipse cx="6.3" cy="10.8" rx="1.8" ry="2.4" transform="rotate(-18 6.3 10.8)" />
        <ellipse cx="9.8" cy="8" rx="1.8" ry="2.5" transform="rotate(-6 9.8 8)" />
        <ellipse cx="14.2" cy="8" rx="1.8" ry="2.5" transform="rotate(6 14.2 8)" />
        <ellipse cx="17.7" cy="10.8" rx="1.8" ry="2.4" transform="rotate(18 17.7 10.8)" />
      </g>
    )
  }

  {
    tipo === 'perro' && (
      <g class="relleno">
        {/* Orejas caídas */}
        <path d="M5.5 6 C3 7 2.6 11 4 13.5 C5.2 12.5 6 10 6 8 Z" />
        <path d="M18.5 6 C21 7 21.4 11 20 13.5 C18.8 12.5 18 10 18 8 Z" />
        {/* Cabeza */}
        <circle cx="12" cy="12.5" r="6.2" />
        {/* Ojos y nariz en el color de fondo */}
        <circle class="hueco" cx="9.7" cy="11.5" r="1" />
        <circle class="hueco" cx="14.3" cy="11.5" r="1" />
        <ellipse class="hueco" cx="12" cy="14.2" rx="1.5" ry="1.1" />
      </g>
    )
  }
</svg>

<style>
  .icono-grooming {
    display: inline-block;
    color: var(--color-primario);
  }
  .relleno {
    fill: currentColor;
  }
  .trazo {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trazo .pivote {
    fill: currentColor;
    stroke: none;
  }
  /* "Huecos" (ojos/nariz) del color de la superficie para que se vean recortados */
  .hueco {
    fill: var(--color-superficie);
  }
</style>
