---
/**
 * Tarjeta de prenda para la grilla del catálogo. La foto se optimiza con
 * astro:assets (AVIF/WebP + tamaños responsivos) cuando es JPG/PNG; los
 * SVG placeholder pasan tal cual.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatCLP } from '../utils/money';

interface Props {
  prenda: CollectionEntry<'prendas'>;
}

const { prenda } = Astro.props;
const { nombre, descripcion, talla, precio, foto, fotoAlt, stock } = prenda.data;
const agotada = stock === 0;
---

<article class:list={['tarjeta', { agotada }]}>
  <a href={`/ropita/${prenda.id}/`}>
    <div class="foto">
      <Image src={foto} alt={fotoAlt} width={600} height={600} loading="lazy" />
      <span class="sello-hechoamano sello-foto">
        <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
          <path d="M12,21 C12,21 3,14 3,8 C3,5 5,3.5 7.2,3.5 C9,3.5 11,5 12,7 C13,5 15,3.5 16.8,3.5 C19,3.5 21,5 21,8 C21,14 12,21 12,21 Z" />
        </svg>
        Hecho a mano
      </span>
      {agotada && <span class="etiqueta">Agotada</span>}
    </div>
    <div class="info">
      <h2>{nombre}</h2>
      <p class="descripcion">{descripcion}</p>
      <p class="datos">
        <span class="precio">{formatCLP(precio)}</span>
        <span class="talla">Talla {talla}</span>
      </p>
    </div>
  </a>
</article>

<style>
  .tarjeta {
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    /* Esquina inferior-izquierda orgánica, como las tarjetas de servicio */
    border-radius: var(--radio-m) var(--radio-m) var(--radio-m) calc(var(--radio-m) * 2.2);
    overflow: hidden;
    box-shadow: var(--sombra-tarjeta);
    transition: transform 0.18s ease, box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 22px oklch(0.4 0.06 155 / 0.14);
    }

    & > a {
      display: block;
      color: inherit;
      text-decoration: none;
    }
  }

  /* Sello "hecho a mano" flotando sobre la esquina de la foto */
  .sello-foto {
    position: absolute;
    top: var(--espacio-s);
    left: var(--espacio-s);
    box-shadow: 0 1px 4px oklch(0.3 0.02 150 / 0.18);
  }

  .agotada .sello-foto {
    display: none;
  }

  .foto {
    position: relative;
    aspect-ratio: 1;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .agotada .foto {
    opacity: 0.55;
  }

  .etiqueta {
    position: absolute;
    top: var(--espacio-s);
    right: var(--espacio-s);
    padding: 0.2em 0.8em;
    border-radius: var(--radio-pill);
    background: var(--color-error);
    color: var(--color-texto-invertido);
    font-size: var(--texto-s);
    font-weight: 700;
  }

  .info {
    padding: var(--espacio-m);
  }

  h2 {
    font-size: var(--texto-base);
  }

  .descripcion {
    margin-block: var(--espacio-xs);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .datos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: var(--espacio-s);
  }

  .precio {
    font-weight: 700;
    color: var(--color-primario-fuerte);
  }

  .talla {
    font-size: var(--texto-s);
    padding: 0.1em 0.7em;
    border-radius: var(--radio-pill);
    background: var(--color-acento-suave);
    color: var(--color-acento-fuerte);
    font-weight: 600;
  }
</style>
