---
/**
 * Theme switch in the footer: Automático (follows the phone/computer
 * setting), Claro or Oscuro.
 *
 * The choice is stored in localStorage ("hv-tema") and applied as
 * data-tema on <html>; tokens.css maps it to the light or dark palette.
 * A tiny inline script in Base.astro applies it before the first paint, so
 * a forced theme never flashes the other one while the page loads.
 */
const opciones = [
  { valor: 'auto', texto: 'Automático' },
  { valor: 'claro', texto: 'Claro' },
  { valor: 'oscuro', texto: 'Oscuro' },
] as const;
---

<div class="selector-tema" role="group" aria-labelledby="titulo-tema">
  <p id="titulo-tema" class="selector-tema__titulo">Apariencia</p>
  <div class="selector-tema__opciones">
    {
      opciones.map((o) => (
        <button type="button" data-tema-opcion={o.valor} aria-pressed={o.valor === 'auto' ? 'true' : 'false'}>
          {o.valor === 'auto' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8" />
              <path d="M12 4a8 8 0 0 1 0 16z" class="lleno" />
            </svg>
          )}
          {o.valor === 'claro' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          )}
          {o.valor === 'oscuro' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            </svg>
          )}
          {o.texto}
        </button>
      ))
    }
  </div>
</div>

<script>
  const CLAVE = 'hv-tema';
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-tema-opcion]');

  /**
   * Applies a theme to <html>, remembers it and updates the pressed button.
   *
   * @param valor - "auto", "claro" or "oscuro".
   */
  function aplicar(valor: string) {
    if (valor === 'claro' || valor === 'oscuro') {
      document.documentElement.dataset.tema = valor;
    } else {
      delete document.documentElement.dataset.tema;
      valor = 'auto';
    }
    try {
      if (valor === 'auto') localStorage.removeItem(CLAVE);
      else localStorage.setItem(CLAVE, valor);
    } catch {
      // Private mode / blocked storage: the theme still applies to this page.
    }
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.temaOpcion === valor)));
  }

  // Reflect the theme already applied by the inline script in Base.astro.
  aplicar(document.documentElement.dataset.tema ?? 'auto');
  botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.temaOpcion!)));
</script>

<style>
  .selector-tema {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-s) var(--espacio-m);
    margin-block-start: var(--espacio-xl);
  }

  .selector-tema__titulo {
    font-weight: 600;
    color: var(--color-texto);
  }

  /* Segmented control: three options in one pill */
  .selector-tema__opciones {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-pill);
    background: var(--color-fondo);
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: 44px;
    padding-inline: 0.85em;
    border: 0;
    border-radius: var(--radio-pill);
    background: transparent;
    color: var(--color-texto-suave);
    font-size: var(--texto-s);
    font-weight: 600;
    cursor: pointer;

    &:hover {
      color: var(--color-texto);
    }

    &[aria-pressed='true'] {
      background: var(--color-superficie);
      color: var(--color-texto);
      box-shadow: var(--sombra-tarjeta);
    }
  }

  svg {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;

    & .lleno {
      fill: currentColor;
      stroke: none;
    }
  }
</style>
