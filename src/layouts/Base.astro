---
/**
 * Layout base de todas las páginas: <head> con SEO/OG, header, footer y
 * Schema.org LocalBusiness. Cada página define su título y descripción.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import { NEGOCIO } from '../data/negocio';

interface Props {
  titulo: string;
  descripcion?: string;
  /**
   * `true` pide a Google que no indexe la página. Se usa en borradores que
   * ya están enlazados pero todavía no tienen el contenido definitivo.
   */
  noindex?: boolean;
  /**
   * Voz visual de la página (`data-vertical` en <body>). Si no se pasa se
   * deriva de la ruta: tienda, peluquería o general.
   */
  vertical?: 'peluqueria' | 'tienda' | 'general';
}

const RUTAS_TIENDA = ['/plantas', '/accesorios', '/carrito', '/pago'];
const RUTAS_PELUQUERIA = ['/servicios', '/reservar'];
/** `/plantas` y `/plantas/x` coinciden; `/plantasX` no. */
const enRuta = (ruta: string, bases: string[]) =>
  bases.some((b) => ruta === b || ruta.startsWith(`${b}/`));

const { titulo, descripcion = NEGOCIO.descripcion, noindex = false, vertical: verticalProp } = Astro.props;
const ruta = Astro.url.pathname;
const vertical =
  verticalProp ?? (enRuta(ruta, RUTAS_TIENDA) ? 'tienda' : enRuta(ruta, RUTAS_PELUQUERIA) ? 'peluqueria' : 'general');
const tituloCompleto = `${titulo} · ${NEGOCIO.nombre}`;
const canonical = new URL(Astro.url.pathname, NEGOCIO.url);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph: cómo se ve el enlace al compartirlo por WhatsApp/Instagram -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', NEGOCIO.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />

    <SchemaLocalBusiness />
  </head>
  <body data-vertical={vertical}>
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Enlace "saltar al contenido": invisible hasta que se navega con Tab */
  .saltar-contenido {
    position: absolute;
    top: -100%;
    left: var(--espacio-m);
    z-index: 100;
    padding: var(--espacio-s) var(--espacio-m);
    background: var(--color-superficie);
    border-radius: 0 0 var(--radio-s) var(--radio-s);
    font-weight: 600;

    &:focus {
      top: 0;
    }
  }

  main {
    min-height: 60vh;
  }
</style>
