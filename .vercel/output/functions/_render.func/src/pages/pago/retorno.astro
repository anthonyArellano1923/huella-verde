---
/**
 * Página de retorno de MercadoPago (prerender = false: corre en el servidor,
 * porque debe VERIFICAR el pago contra la API de MP).
 *
 * MP redirige con query params (?payment_id=&status=&external_reference=...),
 * pero esos parámetros los trae el NAVEGADOR del cliente y podrían
 * falsificarse. Por eso el estado que se muestra sale de consultar el
 * payment_id directamente a la API de MercadoPago con el access token:
 * la única fuente de verdad.
 */
import Base from '../../layouts/Base.astro';
import { NEGOCIO } from '../../data/negocio';
import { formatCLP } from '../../utils/money';
import { waLink } from '../../utils/whatsapp';
import { mpPayment } from '../../lib/mercadopago';

export const prerender = false;

const params = Astro.url.searchParams;
const paymentId = params.get('payment_id') ?? params.get('collection_id');

type Estado = 'aprobado' | 'pendiente' | 'rechazado' | 'invalido' | 'error';
let estado: Estado = 'invalido';
let detalle: { referencia: string; monto: number; medio: string; idPago: string } | null = null;

if (paymentId && paymentId !== 'null') {
  try {
    const pago = await mpPayment().get({ id: paymentId });
    if (pago.status === 'approved') {
      estado = 'aprobado';
    } else if (pago.status === 'in_process' || pago.status === 'pending') {
      // Ej: pago en efectivo — se acredita después.
      estado = 'pendiente';
    } else {
      estado = 'rechazado';
    }
    detalle = {
      referencia: pago.external_reference ?? '—',
      monto: pago.transaction_amount ?? 0,
      medio: pago.payment_method_id ?? 'MercadoPago',
      idPago: String(pago.id),
    };
  } catch (err) {
    console.error('Error verificando pago en MercadoPago:', err);
    estado = 'error';
  }
}

const esReserva = detalle?.referencia.includes('-RS-') ?? false;
const waComprobante = detalle
  ? waLink(
      `¡Hola! Acabo de pagar con MercadoPago en la web de ${NEGOCIO.nombre}.\n` +
        `Referencia: ${detalle.referencia}\n` +
        `Pago MP: ${detalle.idPago}\n` +
        `Monto: ${formatCLP(detalle.monto)}\n` +
        (esReserva
          ? 'Es el pago de una reserva — te confirmo la hora que agendé.'
          : 'Es una compra de ropita — ¿coordinamos la entrega?')
    )
  : '';

const titulos: Record<Estado, string> = {
  aprobado: '¡Pago aprobado! 🎉',
  pendiente: 'Pago en proceso',
  rechazado: 'Pago rechazado',
  invalido: 'Página de retorno de pagos',
  error: 'No pudimos verificar tu pago',
};
---

<Base titulo={titulos[estado]} descripcion="Resultado de tu pago con MercadoPago.">
  <div class="contenedor resultado">
    <h1>{titulos[estado]}</h1>

    {
      (estado === 'aprobado' || estado === 'pendiente') && detalle && (
        <>
          <dl class:list={['voucher', { pendiente: estado === 'pendiente' }]}>
            <div>
              <dt>Referencia</dt>
              <dd>{detalle.referencia}</dd>
            </div>
            <div>
              <dt>Monto</dt>
              <dd>{formatCLP(detalle.monto)}</dd>
            </div>
            <div>
              <dt>Medio de pago</dt>
              <dd>{detalle.medio}</dd>
            </div>
            <div>
              <dt>N° de pago MP</dt>
              <dd>{detalle.idPago}</dd>
            </div>
          </dl>

          {estado === 'pendiente' && (
            <p class="nota-pendiente">
              Tu pago está en proceso (por ejemplo, pago en efectivo o
              transferencia que tarda en acreditarse). Te llegará un correo de
              MercadoPago cuando se confirme.
            </p>
          )}

          {esReserva ? (
            <div class="siguiente">
              <h2>Último paso: elige tu hora</h2>
              <p>
                Tu pago quedó registrado con la referencia <strong>{detalle.referencia}</strong>.
                Ahora agenda la hora en el calendario y <strong>escribe esta referencia en las
                notas de la reserva</strong> para que Martha la asocie a tu pago.
              </p>
              <a class="boton" href="/reservar/">Agendar mi hora →</a>
            </div>
          ) : (
            <div class="siguiente">
              <h2>¿Y ahora?</h2>
              <p>
                Guarda pantallazo de esta página. Escríbenos por WhatsApp para
                coordinar la entrega (retiro en la peluquería o encomienda):
              </p>
              <a class="boton boton--whatsapp" href={waComprobante} rel="noopener">
                Coordinar entrega por WhatsApp
              </a>
            </div>
          )}

          {estado === 'aprobado' && !esReserva && <p class="script-carrito" data-limpiar-carrito="" />}
        </>
      )
    }

    {
      estado === 'rechazado' && (
        <p>
          El pago no fue autorizado (fondos, cupo o datos del medio de pago).
          No se descontó dinero. Puedes <a href="/carrito/">intentar de nuevo</a> con
          otro medio, o <a href="/ropita/">volver al catálogo</a>.
        </p>
      )
    }

    {
      estado === 'error' && (
        <p>
          Ocurrió un problema al verificar con MercadoPago. <strong>Si viste el
          comprobante de MP, tu pago probablemente se realizó</strong> —
          escríbenos por <a href={waLink(`Hola, pagué con MercadoPago en la web de ${NEGOCIO.nombre} pero la verificación falló. ¿Me ayudan a revisar?`)} rel="noopener">WhatsApp</a> y
          lo revisamos al tiro.
        </p>
      )
    }

    {
      estado === 'invalido' && (
        <p>
          Esta página muestra el resultado de un pago con MercadoPago. Si
          llegaste aquí por error, <a href="/">vuelve al inicio</a>.
        </p>
      )
    }
  </div>
</Base>

<script>
  // Si el pago de PRODUCTOS fue aprobado, el carrito ya no corresponde.
  // (Las reservas no tocan el carrito.)
  if (document.querySelector('[data-limpiar-carrito]')) {
    localStorage.removeItem('mm-carrito');
  }
</script>

<style>
  .resultado {
    padding-block: var(--espacio-xl);
    max-width: 42rem;

    & h1 {
      margin-block-end: var(--espacio-l);
    }

    & p {
      color: var(--color-texto-suave);
    }
  }

  .voucher {
    display: grid;
    gap: var(--espacio-m);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0 0 var(--espacio-l);
    padding: var(--espacio-l);
    background: var(--color-superficie);
    border: 2px solid var(--color-exito);
    border-radius: var(--radio-m);

    &.pendiente {
      border-color: var(--color-acento);
    }

    & dt {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
    }

    & dd {
      margin: 0;
      font-weight: 700;
      overflow-wrap: anywhere;
    }
  }

  .nota-pendiente {
    margin-block-end: var(--espacio-l);
  }

  .siguiente {
    padding: var(--espacio-l);
    background: var(--color-acento-suave);
    border-radius: var(--radio-m);

    & h2 {
      font-size: var(--texto-l);
      margin-block-end: var(--espacio-s);
    }

    & p {
      margin-block-end: var(--espacio-m);
      color: var(--color-texto);
    }
  }

  .script-carrito {
    display: none;
  }
</style>
