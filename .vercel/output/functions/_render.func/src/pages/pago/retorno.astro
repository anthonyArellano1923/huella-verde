---
/**
 * Página de retorno de Webpay (prerender = false: corre en el servidor en
 * cada visita, porque debe CONFIRMAR la transacción con Transbank).
 *
 * Flujos posibles según lo que manda Webpay:
 * - `token_ws` presente → el cliente terminó el formulario de pago; hay que
 *   hacer commit() DEL LADO DEL SERVIDOR para saber si fue autorizado o
 *   rechazado. Sin commit, el pago queda en el limbo y se reversa solo.
 * - `TBK_TOKEN` presente → el cliente anuló dentro de Webpay.
 * - Nada → alguien entró directo a la URL.
 */
import Base from '../../layouts/Base.astro';
import { NEGOCIO } from '../../data/negocio';
import { formatCLP } from '../../utils/money';
import { waLink } from '../../utils/whatsapp';
import { webpayTransaction } from '../../lib/transbank';

export const prerender = false;

// Webpay puede volver por GET o por POST según el flujo: se revisan ambos.
const params =
  Astro.request.method === 'POST'
    ? new URLSearchParams(await Astro.request.text())
    : Astro.url.searchParams;

const tokenWs = params.get('token_ws');
const tokenAnulacion = params.get('TBK_TOKEN');

type Estado = 'aprobado' | 'rechazado' | 'anulado' | 'invalido' | 'error';
let estado: Estado = 'invalido';
let detalle: { buyOrder: string; monto: number; tarjeta: string; codigoAutorizacion: string } | null = null;

if (tokenWs) {
  try {
    const tx = webpayTransaction();
    const r = await tx.commit(tokenWs);
    if (r.response_code === 0 && r.status === 'AUTHORIZED') {
      estado = 'aprobado';
      detalle = {
        buyOrder: r.buy_order,
        monto: r.amount,
        tarjeta: r.card_detail?.card_number ?? '****',
        codigoAutorizacion: r.authorization_code,
      };
    } else {
      estado = 'rechazado';
    }
  } catch (err) {
    console.error('Error confirmando transacción Webpay:', err);
    estado = 'error';
  }
} else if (tokenAnulacion) {
  estado = 'anulado';
}

const esReserva = detalle?.buyOrder.includes('-RS-') ?? false;
const waComprobante = detalle
  ? waLink(
      `¡Hola! Acabo de pagar con Webpay en la web de ${NEGOCIO.nombre}.\n` +
        `Orden: ${detalle.buyOrder}\n` +
        `Monto: ${formatCLP(detalle.monto)}\n` +
        (esReserva
          ? 'Es el pago de una reserva — te confirmo la hora que agendé.'
          : 'Es una compra de ropita — ¿coordinamos la entrega?')
    )
  : '';

const titulos: Record<Estado, string> = {
  aprobado: '¡Pago aprobado! 🎉',
  rechazado: 'Pago rechazado',
  anulado: 'Pago anulado',
  invalido: 'Página de retorno de pagos',
  error: 'No pudimos confirmar tu pago',
};
---

<Base titulo={titulos[estado]} descripcion="Resultado de tu pago con Webpay.">
  <div class="contenedor resultado">
    <h1>{titulos[estado]}</h1>

    {
      estado === 'aprobado' && detalle && (
        <>
          <dl class="voucher">
            <div>
              <dt>Orden de compra</dt>
              <dd>{detalle.buyOrder}</dd>
            </div>
            <div>
              <dt>Monto pagado</dt>
              <dd>{formatCLP(detalle.monto)}</dd>
            </div>
            <div>
              <dt>Tarjeta</dt>
              <dd>**** {detalle.tarjeta.slice(-4)}</dd>
            </div>
            <div>
              <dt>Código de autorización</dt>
              <dd>{detalle.codigoAutorizacion}</dd>
            </div>
          </dl>

          {esReserva ? (
            <div class="siguiente">
              <h2>Último paso: elige tu hora</h2>
              <p>
                Tu pago quedó registrado con la orden <strong>{detalle.buyOrder}</strong>.
                Ahora agenda la hora en el calendario y <strong>escribe esta orden en las
                notas de la reserva</strong> para que Martha la asocie a tu pago.
              </p>
              <a class="boton" href="/reservar/">Agendar mi hora →</a>
            </div>
          ) : (
            <div class="siguiente">
              <h2>¿Y ahora?</h2>
              <p>
                Guarda pantallazo de esta página. Escríbenos por WhatsApp para
                coordinar la entrega (retiro en la peluquería o encomienda):
              </p>
              <a class="boton boton--whatsapp" href={waComprobante} rel="noopener">
                Coordinar entrega por WhatsApp
              </a>
            </div>
          )}

          <p class="script-carrito" data-limpiar-carrito={esReserva ? undefined : ''} />
        </>
      )
    }

    {
      estado === 'rechazado' && (
        <p>
          Tu banco no autorizó el pago (fondos, cupo o datos de la tarjeta).
          No se descontó dinero. Puedes <a href="/carrito/">intentar de nuevo</a> con
          otra tarjeta, o <a href="/ropita/">volver al catálogo</a>.
        </p>
      )
    }

    {
      estado === 'anulado' && (
        <p>
          Cancelaste el pago en Webpay — no se cobró nada.
          Tu carrito sigue guardado si quieres <a href="/carrito/">retomarlo</a>.
        </p>
      )
    }

    {
      estado === 'error' && (
        <p>
          Ocurrió un problema al confirmar con Transbank. <strong>Si viste el
          comprobante de Webpay, tu pago probablemente se realizó</strong> —
          escríbenos por <a href={waLink(`Hola, pagué con Webpay en la web de ${NEGOCIO.nombre} pero la confirmación falló. ¿Me ayudan a verificar?`)} rel="noopener">WhatsApp</a> y
          lo verificamos al tiro. Si no alcanzaste a pagar, intenta de nuevo.
        </p>
      )
    }

    {
      estado === 'invalido' && (
        <p>
          Esta página muestra el resultado de un pago con Webpay. Si llegaste
          aquí por error, <a href="/">vuelve al inicio</a>.
        </p>
      )
    }
  </div>
</Base>

<script>
  // Si el pago de PRODUCTOS fue aprobado, el carrito ya no corresponde.
  // (Las reservas no tocan el carrito.)
  if (document.querySelector('[data-limpiar-carrito]')) {
    localStorage.removeItem('mm-carrito');
  }
</script>

<style>
  .resultado {
    padding-block: var(--espacio-xl);
    max-width: 42rem;

    & h1 {
      margin-block-end: var(--espacio-l);
    }

    & p {
      color: var(--color-texto-suave);
    }
  }

  .voucher {
    display: grid;
    gap: var(--espacio-m);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0 0 var(--espacio-l);
    padding: var(--espacio-l);
    background: var(--color-superficie);
    border: 2px solid var(--color-exito);
    border-radius: var(--radio-m);

    & dt {
      font-size: var(--texto-s);
      color: var(--color-texto-suave);
    }

    & dd {
      margin: 0;
      font-weight: 700;
      overflow-wrap: anywhere;
    }
  }

  .siguiente {
    padding: var(--espacio-l);
    background: var(--color-acento-suave);
    border-radius: var(--radio-m);

    & h2 {
      font-size: var(--texto-l);
      margin-block-end: var(--espacio-s);
    }

    & p {
      margin-block-end: var(--espacio-m);
      color: var(--color-texto);
    }
  }

  .script-carrito {
    display: none;
  }
</style>
