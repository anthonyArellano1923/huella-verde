# --- Pasarela de pago activa ---
# webpay (por defecto, funciona sin credenciales en integración) | mercadopago
PASARELA_PAGO=webpay

# --- Webpay Plus (Transbank) ---
# Vacío = ambiente de INTEGRACIÓN con credenciales de prueba públicas (no tocar).
# Producción: pedir a Transbank y definir en Vercel (no aquí).
# TBK_COMMERCE_CODE=
# TBK_API_KEY=
# TBK_ENV=produccion

# --- MercadoPago Checkout Pro ---
# Requerido SOLO si PASARELA_PAGO=mercadopago.
# TODO(Anthony): token de PRUEBA "TEST-..." desde developers.mercadopago.com.
# Producción: token "APP_USR-..." definido en Vercel, no aquí.
MP_ACCESS_TOKEN=
